<% content_for :title, @mode == "register" ? "Add a Passkey" : "Sign In" %>

<div class="m3-card p-8 w-full max-w-sm text-center">
  <div class="flex items-center justify-center mb-5">
    <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center">
      <svg class="w-8 h-8 text-on-primary-container" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 1a5 5 0 0 0-5 5c0 2.2 1.4 4.1 3.4 4.7L10 12v2H8v2h2v2l2 2 2-2V10.7A5 5 0 0 0 12 1zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
      </svg>
    </div>
  </div>

  <h1 class="text-xl font-semibold text-on-surface mb-1">
    <%= @mode == "register" ? "Add a passkey" : "Sign in with a passkey" %>
  </h1>

  <p id="status" class="text-sm text-on-surface-variant">
    <%= @mode == "register" ? "Confirm with your device to finish." : "Choose your passkey to continue." %>
  </p>

  <div id="retry" class="mt-6 hidden">
    <button type="button" id="retry-button"
            class="m3-button-filled px-5 py-2.5 text-sm rounded-full">
      Try again
    </button>
  </div>
</div>

<%# The ceremony runs here so the origin the browser reports is this site's,
    not the extension's. See PasskeysController. %>
<script type="module">
  const MODE         = <%= raw @mode.to_json %>;
  const REDIRECT_URI = <%= raw @redirect_uri.to_json %>;
  const STATE        = <%= raw @state.to_json %>;
  const HANDOFF      = <%= raw @handoff.to_json %>;
  const NICKNAME     = <%= raw @nickname.to_json %>;

  const status = document.getElementById('status');
  const retry  = document.getElementById('retry');

  function say(message) {
    status.textContent = message;
  }

  function offerRetry() {
    retry.classList.remove('hidden');
  }

  function base64UrlToBytes(value) {
    const padded = value.replace(/-/g, '+').replace(/_/g, '/');
    const binary = atob(padded.padEnd(Math.ceil(padded.length / 4) * 4, '='));
    const buffer = new ArrayBuffer(binary.length);
    const bytes  = new Uint8Array(buffer);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return buffer;
  }

  function bytesToBase64Url(buffer) {
    const bytes = new Uint8Array(buffer);
    let binary = '';
    for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  async function post(path, body) {
    const response = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body ?? {})
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
    return data;
  }

  // Hands the result back to the extension. Only ever a single-use code, never
  // a session token, because this lands in browser history.
  function handBack(params) {
    const target = new URL(REDIRECT_URI);
    if (STATE) target.searchParams.set('state', STATE);
    for (const [key, value] of Object.entries(params)) target.searchParams.set(key, value);
    window.location.replace(target.toString());
  }

  async function register() {
    const { handle, options } = await post('/api/user/passkeys/registration_options', { handoff: HANDOFF });

    const credential = await navigator.credentials.create({
      publicKey: {
        ...options,
        challenge: base64UrlToBytes(options.challenge),
        user: { ...options.user, id: base64UrlToBytes(options.user.id) },
        excludeCredentials: (options.excludeCredentials ?? []).map((c) => ({
          ...c, id: base64UrlToBytes(c.id)
        }))
      }
    });

    const attestation = credential.response;
    // The handoff authenticates this call too, and is spent here.
    await post('/api/user/passkeys', {
      handle,
      handoff: HANDOFF,
      nickname: NICKNAME,
      credential: {
        type: credential.type,
        id: credential.id,
        rawId: bytesToBase64Url(credential.rawId),
        authenticatorAttachment: credential.authenticatorAttachment,
        response: {
          attestationObject: bytesToBase64Url(attestation.attestationObject),
          clientDataJSON: bytesToBase64Url(attestation.clientDataJSON)
        }
      }
    });

    say('Passkey added. Returning to the extension…');
    handBack({ status: 'registered' });
  }

  async function signIn() {
    const { handle, options } = await post('/api/user/passkeys/authentication_options');

    const credential = await navigator.credentials.get({
      publicKey: {
        ...options,
        challenge: base64UrlToBytes(options.challenge),
        allowCredentials: (options.allowCredentials ?? []).map((c) => ({
          ...c, id: base64UrlToBytes(c.id)
        }))
      }
    });

    const assertion = credential.response;
    const { code } = await post('/api/user/passkeys/authenticate', {
      handle,
      handoff: true,
      credential: {
        type: credential.type,
        id: credential.id,
        rawId: bytesToBase64Url(credential.rawId),
        authenticatorAttachment: credential.authenticatorAttachment,
        response: {
          authenticatorData: bytesToBase64Url(assertion.authenticatorData),
          clientDataJSON: bytesToBase64Url(assertion.clientDataJSON),
          signature: bytesToBase64Url(assertion.signature),
          userHandle: assertion.userHandle ? bytesToBase64Url(assertion.userHandle) : null
        }
      }
    });

    say('Signed in. Returning to the extension…');
    handBack({ code });
  }

  async function run() {
    retry.classList.add('hidden');
    try {
      await (MODE === 'register' ? register() : signIn());
    } catch (error) {
      // A dismissed prompt is a choice, not a fault. Tell the extension either
      // way so it stops waiting rather than hanging on an open tab.
      if (error instanceof DOMException &&
          (error.name === 'NotAllowedError' || error.name === 'AbortError')) {
        say('Cancelled.');
        handBack({ status: 'cancelled' });
        return;
      }
      console.error(error);
      say(error.message || 'Something went wrong.');
      offerRetry();
    }
  }

  document.getElementById('retry-button').addEventListener('click', run);
  run();
</script>
