<%# Renders a link in the mobile More sheet. Locals: path, label, icon %>
<% active = dashboard_nav_active?(path) %>
<%= link_to path,
    "aria-current": ("page" if active),
    class: "flex items-center gap-3 min-h-11 px-4 py-3 rounded-2xl text-sm transition-colors #{active ? 'bg-secondary-container text-on-secondary-container font-medium' : 'text-on-surface hover:bg-surface-container-high'}" do %>
  <%= icon(icon, css_class: "w-5 h-5 flex-shrink-0", stroke_width: active ? 2.5 : 2) %>
  <%= label %>
<% end %>
