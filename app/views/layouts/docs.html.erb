<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= browser_title("Docs") %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "layouts/favicon" %>
    <%= yield :head %>

    <%# tailwind gives the M3 color tokens and the font. docs lays out the page. %>
    <%= stylesheet_link_tag "tailwind", "docs" %>
  </head>

  <body>
    <a class="docs-skip" href="#content">Skip to content</a>

    <div class="docs-shell">
      <header class="docs-masthead">
        <a class="docs-brand" href="<%= root_path %>">WIT Calendar</a>

        <nav class="docs-nav" aria-label="Docs">
          <ul>
            <li><%= link_to "Catalog API", api_docs_path, "aria-current": (current_page?(api_docs_path) ? "page" : nil) %></li>
            <li><%= link_to "MCP server", mcp_docs_path, "aria-current": (current_page?(mcp_docs_path) ? "page" : nil) %></li>
            <li><%= link_to "Dashboard", dashboard_root_path %></li>
          </ul>
        </nav>
      </header>

      <%= yield %>
    </div>

    <%# Draws the diagrams. If the script does not load, each diagram stays on
        the page as readable source in its code block. The version is exact,
        because the script runs with this origin: a new release must not load
        without a review. config/initializers/content_security_policy.rb sets it. %>
    <script type="module" nonce="<%= content_security_policy_nonce %>">
      const blocks = document.querySelectorAll("pre > code.mermaid");
      if (blocks.length > 0) {
        try {
          const { default: mermaid } = await import(<%= "#{Rails.configuration.x.mermaid_url}dist/mermaid.esm.min.mjs".to_json.html_safe %>);

          // Mermaid reads rgb() with commas only. The M3 tokens hold "r g b".
          const style = getComputedStyle(document.documentElement);
          const token = (name) =>
            `rgb(${style.getPropertyValue(`--m3-scheme-${name}`).trim().split(/\s+/).join(", ")})`;

          mermaid.initialize({
            startOnLoad: false,
            theme: "base",
            fontFamily: '"Roboto Flex", sans-serif',
            themeVariables: {
              background:         token("background"),
              primaryColor:       token("primary-container"),
              primaryTextColor:   token("on-primary-container"),
              primaryBorderColor: token("outline"),
              secondaryColor:     token("secondary-container"),
              tertiaryColor:      token("surface-container-high"),
              lineColor:          token("outline"),
              textColor:          token("on-background"),
              noteBkgColor:       token("surface-container-high"),
              noteTextColor:      token("on-surface"),
              noteBorderColor:    token("outline-variant"),
              actorBkg:           token("primary-container"),
              actorTextColor:     token("on-primary-container"),
              actorBorder:        token("outline"),
              actorLineColor:     token("outline"),
              signalColor:        token("on-background"),
              signalTextColor:    token("on-background"),
              labelBoxBkgColor:   token("surface-container-high"),
              labelTextColor:     token("on-surface")
            }
          });

          blocks.forEach((block) => {
            const holder = document.createElement("div");
            holder.className = "mermaid";
            holder.textContent = block.textContent;
            block.parentElement.replaceWith(holder);
          });

          await mermaid.run({ querySelector: ".mermaid" });
        } catch (error) {
          console.warn("Diagrams stay as source:", error);
        }
      }
    </script>
  </body>
</html>
