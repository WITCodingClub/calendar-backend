<%# The shared HTML layout for every email. Mail clients drop <style> blocks, so every style is inline. Colors come from the light theme in app/assets/tailwind/application.css. A mailer that sets @preferences_url gets a link to the user's email settings in the footer. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
  </head>

  <body style="margin: 0; padding: 0; background-color: #f6f1e7;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f6f1e7;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 560px;">
            <tr>
              <td style="padding: 0 0 16px 0;">
                <a href="<%= root_url %>" style="text-decoration: none; color: #1f1b13;">
                  <img src="<%= root_url %>icon.png" width="32" height="32" alt="" style="vertical-align: middle; border: 0;">
                  <span style="vertical-align: middle; font-family: Arial, Helvetica, sans-serif; font-size: 18px; font-weight: bold; color: #1f1b13;">&nbsp;WIT Calendar</span>
                </a>
              </td>
            </tr>
            <tr>
              <td style="background-color: #ffffff; border-radius: 12px; padding: 24px; font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5; color: #1f1b13;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 16px 8px 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #4d4639;">
                <p style="margin: 0;">WIT Calendar, from the WIT Coding Club.</p>
                <% if @preferences_url %>
                  <p style="margin: 4px 0 0 0;">
                    <a href="<%= @preferences_url %>" style="color: #735b0c;">Change which emails you get</a>
                  </p>
                <% end %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
