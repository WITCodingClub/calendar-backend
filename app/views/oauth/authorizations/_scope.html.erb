<label class="flex items-start gap-3 px-4 py-3 cursor-pointer hover:bg-surface-container-low transition-colors">
  <span class="block flex-1">
    <span class="block text-on-surface"><%= item.scope.label %></span>
    <span class="block text-xs text-on-surface-variant"><%= item.scope.description %></span>
  </span>
  <%= check_box_tag "scopes[]", item.scope.name, item.checked, id: "scope_#{item.scope.name.tr(':', '_')}", class: "mt-1 w-4 h-4 shrink-0 accent-primary" %>
</label>
