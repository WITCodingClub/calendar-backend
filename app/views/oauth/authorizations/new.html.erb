<% content_for :title, "Connect an app" %>
<% redirect_host = Oauth::RedirectUris.hosts(@pre_auth.redirect_uri).first || @pre_auth.redirect_uri %>

<%= render layout: "devise/shared/card", locals: { heading: "Connect #{@pre_auth.client.name}?", intro: "Signed in as #{current_resource_owner.email}", links: false } do %>
  <div class="space-y-4 text-sm text-on-surface">
    <p>
      An app wants to read your WIT Calendar data. After you allow it, it sends you back to
      <strong class="break-all"><%= redirect_host %></strong>.
      Allow it only if you started this from that app.
    </p>

    <div>
      <p class="font-medium">It will be able to read:</p>
      <ul class="list-disc pl-5 mt-1 space-y-1 text-on-surface-variant">
        <li>Your courses, meeting times, and final exams</li>
        <li>The times you are busy</li>
        <li>Your friends list, and the busy times your friends share with you</li>
        <li>The course catalog and the university calendar</li>
      </ul>
    </div>

    <% if Oauth::ClientMetadataDocument.client_id?(@pre_auth.client.uid) %>
      <p class="text-on-surface-variant">
        <%= URI.parse(@pre_auth.client.uid).host %> publishes this app's name and addresses.
      </p>
    <% end %>

    <p class="text-on-surface-variant">
      It cannot change anything. You can disconnect it at any time in Settings.
    </p>

    <%= form_tag oauth_authorization_path, method: :post, data: { turbo: false } do %>
      <%= render "oauth/authorizations/fields", pre_auth: @pre_auth, resource: params[:resource] %>
      <%= submit_tag "Allow", class: "m3-btn-filled w-full justify-center" %>
    <% end %>

    <%= form_tag oauth_authorization_path, method: :delete, data: { turbo: false } do %>
      <%= render "oauth/authorizations/fields", pre_auth: @pre_auth, resource: params[:resource] %>
      <%= submit_tag "Deny", class: "m3-btn-outlined w-full justify-center" %>
    <% end %>
  </div>
<% end %>
