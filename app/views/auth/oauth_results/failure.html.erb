<% content_for :title, "Connection Failed" %>

<%= render "shared/status_card", title: "Connection Failed", icon_name: :x, tone: :error do %>
  <p class="text-sm text-on-surface-variant">Could not connect your Google Calendar.</p>

  <% if @error.present? %>
    <p class="text-xs text-error mt-3 break-words"><%= @error %></p>
  <% end %>

  <p class="mt-6 text-xs text-on-surface-variant/60">Please close this window and try again.</p>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  // Only a page of this app may read the result. The extension does not use
  // this message: its service worker watches the tab URL.
  if (window.opener) {
    window.opener.postMessage({
      type: 'oauth-failure',
      error: <%= json_escape(@error.to_s.to_json).html_safe %>
    }, window.location.origin);
  }
</script>
