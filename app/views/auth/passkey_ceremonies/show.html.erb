<% content_for :title, @mode == "register" ? "Add a Passkey" : "Sign In" %>

<%# passkey_ceremony_controller.js runs the ceremony and hands the result back
    to the extension. %>
<%= tag.div data: {
      controller: "passkey-ceremony",
      passkey_ceremony_mode_value: @mode,
      passkey_ceremony_redirect_uri_value: @redirect_uri,
      passkey_ceremony_state_value: @state,
      passkey_ceremony_handoff_value: @handoff,
      passkey_ceremony_nickname_value: @nickname
    }, class: "w-full max-w-sm" do %>
  <%= render "shared/status_card",
      title: @mode == "register" ? "Add a passkey" : "Sign in with a passkey",
      icon_name: :passkey do %>
    <p class="text-sm text-on-surface-variant" data-passkey-ceremony-target="status">
      <%= @mode == "register" ? "Confirm with your device to finish." : "Choose your passkey to continue." %>
    </p>

    <div class="mt-6" data-passkey-ceremony-target="retry" hidden>
      <button type="button" class="m3-btn-filled" data-action="passkey-ceremony#run">
        Try again
      </button>
    </div>
  <% end %>
<% end %>
