<% content_for :title, "Resend Confirmation" %>

<%= render layout: "devise/shared/card", locals: { heading: "Confirm your account", intro: "We will send the confirmation link again." } do %>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "m3-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "m3-input",
                        value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
    </div>

    <%= f.submit "Send confirmation link", class: "m3-btn-filled w-full justify-center" %>
  <% end %>
<% end %>
