<% content_for :title, "Set New Password" %>

<%= render layout: "devise/shared/card", locals: { heading: "Set a new password" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "New password", class: "m3-label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
                           minlength: @minimum_password_length, class: "m3-input",
                           aria: { describedby: ("password-hint" if @minimum_password_length) } %>
      <% if @minimum_password_length %>
        <p id="password-hint" class="text-xs text-on-surface-variant mt-1">
          At least <%= @minimum_password_length %> characters.
        </p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "m3-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "m3-input" %>
    </div>

    <%= f.submit "Change password", class: "m3-btn-filled w-full justify-center" %>
  <% end %>
<% end %>
