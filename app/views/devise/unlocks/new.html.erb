<% content_for :title, "Unlock Account" %>

<%= render layout: "devise/shared/card", locals: { heading: "Unlock your account", intro: "We will send the unlock link again." } do %>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "m3-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "m3-input" %>
    </div>

    <%= f.submit "Send unlock link", class: "m3-btn-filled w-full justify-center" %>
  <% end %>
<% end %>
