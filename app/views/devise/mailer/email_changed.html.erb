<h2>Your email address changed</h2>

<p>Hi,</p>

<p>
  <% if @resource.try(:unconfirmed_email?) %>
    The email address for your WIT Calendar account is changing to <strong><%= @resource.unconfirmed_email %></strong>.
  <% else %>
    The email address for your WIT Calendar account is now <strong><%= @resource.email %></strong>.
  <% end %>
</p>

<p style="margin-top: 16px;">If you did not make this change, contact us at <%= mail_to Rails.application.config.x.contact_email %>.</p>
