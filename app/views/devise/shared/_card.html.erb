<%# The frame of every Devise page: the same card, logo, and messages as the
    sign-in page. Render it as a layout:
      render layout: "devise/shared/card", locals: { heading:, intro: }
    A page outside Devise (the OAuth consent page) passes links: false. %>
<div class="w-full max-w-sm">
  <div class="m3-card p-8">
    <div class="text-center mb-6">
      <div class="mb-4"><%= logo_mark(:large) %></div>
      <h1 class="text-2xl font-bold text-on-surface"><%= heading %></h1>
      <% if local_assigns[:intro].present? %>
        <p class="text-sm text-on-surface-variant mt-1"><%= intro %></p>
      <% end %>
    </div>

    <% if flash[:alert].present? %>
      <div class="m3-alert-error mb-4" role="alert"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="m3-alert-notice mb-4" role="status"><%= flash[:notice] %></div>
    <% end %>

    <%= yield %>

    <%= render "devise/shared/links" if local_assigns.fetch(:links, true) %>
  </div>
</div>
