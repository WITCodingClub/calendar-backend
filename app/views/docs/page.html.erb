<% content_for :title, @page[:title] %>

<% description = @page[:description] %>

<% content_for :head do %>
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="<%= @page[:url] %>">
  <link rel="alternate" type="text/markdown" href="<%= @page[:markdown_url] %>">

  <meta property="og:type" content="article">
  <meta property="og:site_name" content="<%= ApplicationHelper::SITE_NAME %>">
  <meta property="og:title" content="<%= page_title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= @page[:url] %>">
  <meta name="twitter:card" content="summary">

  <%= structured_data_tag(
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: page_title,
    description: description,
    url: @page[:url],
    inLanguage: "en",
    isAccessibleForFree: true,
    encoding: {
      "@type": "MediaObject",
      encodingFormat: "text/markdown",
      contentUrl: @page[:markdown_url]
    },
    publisher: {
      "@type": "Organization",
      name: "WIT Coding Club",
      url: "https://github.com/WITCodingClub"
    }
  ) %>
<% end %>

<div class="docs">
  <%# Closed on a small screen, so the article starts near the top. The script
      below opens it on a wide screen, where it sits beside the article. %>
  <details class="docs-toc" id="docs-toc">
    <summary>On this page</summary>
    <nav aria-label="On this page">
      <ul>
        <% @headings.each do |heading| %>
          <li><a href="#<%= heading[:id] %>"><%= heading[:text] %></a></li>
        <% end %>
      </ul>
    </nav>
  </details>
  <script nonce="<%= content_security_policy_nonce %>">
    (() => {
      const toc  = document.getElementById("docs-toc");
      const wide = window.matchMedia("(min-width: 1024px)");
      const sync = () => { toc.open = wide.matches; };
      sync();
      wide.addEventListener("change", sync);
    })();
  </script>

  <main id="content" class="docs-body" tabindex="-1">
    <article>
      <%= @body %>
    </article>
  </main>
</div>
