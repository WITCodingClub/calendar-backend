<%= render "admin/shared/page_header", title: "Calendars", subtitle: "Course calendars that the app syncs to Google and Outlook." %>

<%= render "admin/shared/filters",
    url: admin_calendars_path,
    search: "Search by user email",
    selects: [ { name: :provider, label: "Provider", options: CourseCalendar.providers.keys.map { |p| [ p.titleize, p ] }, blank: "All providers" } ] %>

<%= admin_table(@calendars, empty: "No calendars match.") do |t| %>
  <% t.column("User") do |calendar| %>
    <% if calendar.user %>
      <%= link_to calendar.user.full_name, admin_user_path(calendar.user), class: "font-medium text-primary hover:underline" %>
      <div class="text-xs text-on-surface-variant break-all"><%= calendar.oauth_credential&.email %></div>
    <% else %>
      <span class="text-on-surface-variant">No user</span>
    <% end %>
  <% end %>
  <% t.column("Provider") { |calendar| admin_badge(calendar.provider.titleize, :info) } %>
  <% t.column("Calendar ID") { |calendar| tag.span(truncate(calendar.external_calendar_id, length: 32), title: calendar.external_calendar_id, class: "font-mono text-xs text-on-surface-variant") } %>
  <% t.column("Last sync") do |calendar| %>
    <% if calendar.last_synced_at %>
      <span title="<%= l(calendar.last_synced_at, format: :long) %>"><%= time_ago_in_words(calendar.last_synced_at) %> ago</span>
      <% if calendar.last_synced_at < CourseCalendar::STALE_AFTER.ago %>
        <%= admin_badge("Stale", :warning) %>
      <% end %>
    <% else %>
      <%= admin_badge("Never synced", :warning) %>
    <% end %>
  <% end %>
  <% t.column("Actions", align: :right, primary: false) do |calendar| %>
    <% if policy(calendar).destroy? %>
      <%= button_to "Delete", admin_calendar_path(calendar.id),
          method: :delete,
          form: { data: { turbo_confirm: "Permanently delete the calendar for #{calendar.user&.email}? This deletes all of its events. You cannot undo it." } },
          class: "m3-btn-text text-error" %>
    <% end %>
  <% end %>
<% end %>
