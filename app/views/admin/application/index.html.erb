<%= render "admin/shared/page_header", title: "Dashboard", subtitle: "The state of WIT Calendar at a glance." %>

<% counts = @dashboard.counts %>
<%= render "admin/shared/stats" do %>
  <%= render "admin/shared/stat", label: "Users", value: counts[:users], path: admin_users_path, hint: "#{number_with_delimiter(@dashboard.sign_ups_this_week)} new this week" %>
  <%= render "admin/shared/stat", label: "Calendars", value: counts[:calendars], path: admin_calendars_path %>
  <%= render "admin/shared/stat", label: "Courses", value: counts[:courses], path: admin_courses_path %>
  <%= render "admin/shared/stat", label: "Faculty", value: counts[:faculty], path: admin_faculties_path %>
  <%= render "admin/shared/stat", label: "Terms", value: counts[:terms], path: admin_terms_path %>
  <%= render "admin/shared/stat", label: "RMP ratings", value: counts[:rmp_ratings], path: admin_rmp_ratings_path %>
  <%= render "admin/shared/stat", label: "Final exams", value: counts[:final_exams], path: admin_finals_schedules_path %>
  <%= render "admin/shared/stat", label: "University events", value: counts[:university_events], path: admin_university_calendar_events_path %>
<% end %>

<% if @dashboard.attention.any? %>
  <section aria-labelledby="attention-heading" class="mb-6 px-4 py-3 rounded-xl <%= AdminHelper::BADGE_TONES[:warning] %>">
    <h2 id="attention-heading" class="flex items-center gap-2 text-sm font-semibold"><%= admin_icon(:exclamation, css_class: "w-5 h-5") %> Needs attention</h2>
    <ul class="mt-2 flex flex-wrap gap-2">
      <% @dashboard.attention.each do |entry| %>
        <li>
          <%= link_to public_send(entry[:path]), class: "inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface/60 text-sm hover:bg-surface" do %>
            <span class="font-semibold tabular-nums"><%= number_with_delimiter(entry[:count]) %></span> <%= entry[:label] %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <div class="xl:col-span-2 space-y-6">
    <% health = @dashboard.sync_health %>
    <% status_badge = { ok: [ "Healthy", :success ], warning: [ "Some stale", :warning ], danger: [ "Many stale", :danger ] }.fetch(@dashboard.sync_status) %>
    <%= render "admin/shared/card", title: "Calendar sync health", subtitle: "The sync runs every six hours. A calendar with no sync for a day is stale.", actions: admin_badge(*status_badge), id: "sync-health" do %>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <%= render "admin/shared/stat", label: "Synced in last day", value: health[:healthy], tone: :success %>
        <%= render "admin/shared/stat", label: "Stale", value: health[:stale], tone: (health[:stale].positive? ? :warning : nil), hint: "#{number_with_delimiter(health[:never_synced])} never synced" %>
        <%= render "admin/shared/stat", label: "Users waiting", value: health[:users_needing_sync], hint: "Flagged for the next sync" %>
        <%= render "admin/shared/stat", label: "Revoked credentials", value: health[:revoked_credentials], tone: (health[:revoked_credentials].positive? ? :danger : nil) %>
        <%= render "admin/shared/stat", label: "Last sync", value: health[:last_synced_at] ? "#{time_ago_in_words(health[:last_synced_at])} ago" : "Never" %>
      </div>
    <% end %>

    <% jobs_item = Admin::NavigationRegistry.item_for(current_user, :jobs) %>
    <% jobs_link = capture do %>
      <% if jobs_item %>
        <%= link_to "Open job dashboard", admin_nav_path(jobs_item), target: "_blank", rel: "noopener", class: "m3-btn-text" %>
      <% end %>
    <% end %>
    <%= render "admin/shared/card", title: "Failed jobs", subtitle: "#{number_with_delimiter(@dashboard.failed_jobs_count)} failed, newest first", actions: jobs_link, flush: true, id: "failed-jobs" do %>
      <% if @dashboard.recent_failed_jobs.any? %>
        <ul class="divide-y divide-outline-variant">
          <% @dashboard.recent_failed_jobs.each do |failure| %>
            <li class="px-4 sm:px-6 py-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <% if jobs_item %>
                  <%= link_to failure.job.class_name, admin_mission_control_jobs.application_job_path("calendar", failure.job.active_job_id, anchor: "error"), target: "_blank", rel: "noopener", class: "font-medium text-primary hover:underline" %>
                <% else %>
                  <span class="font-medium"><%= failure.job.class_name %></span>
                <% end %>
                <span class="text-xs text-on-surface-variant" title="<%= l(failure.created_at, format: :long) %>"><%= time_ago_in_words(failure.created_at) %> ago</span>
              </div>
              <p class="mt-1 text-xs text-error font-mono break-words"><%= failure.exception_class %>: <%= truncate(failure.message.to_s, length: 160) %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-4 py-8">
          <%= render "admin/shared/empty_state", icon: :check_circle, message: "No failed jobs." %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-6">
    <%= render "admin/shared/card", title: "Recent sign-ups", actions: link_to("All users", admin_users_path, class: "m3-btn-text"), flush: true, id: "recent-sign-ups" do %>
      <% if @dashboard.recent_sign_ups.any? %>
        <ul class="divide-y divide-outline-variant">
          <% @dashboard.recent_sign_ups.each do |user| %>
            <li class="flex items-center justify-between gap-3 px-4 sm:px-6 py-2.5">
              <div class="min-w-0">
                <%= link_to user.full_name, admin_user_path(user), class: "block text-sm font-medium text-primary hover:underline truncate" %>
                <p class="text-xs text-on-surface-variant truncate"><%= user.email %></p>
              </div>
              <span class="text-xs text-on-surface-variant whitespace-nowrap"><%= time_ago_in_words(user.created_at) %> ago</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-4 py-8"><%= render "admin/shared/empty_state", message: "No users yet." %></div>
      <% end %>
    <% end %>

    <% tools = %i[jobs feature_flags database sql console_audits].filter_map { |id| Admin::NavigationRegistry.item_for(current_user, id) } %>
    <% if tools.any? %>
      <%= render "admin/shared/card", title: "Tools", subtitle: "Each tool opens in a new tab.", flush: true, id: "tools" do %>
        <ul class="p-2">
          <% tools.each do |item| %>
            <li>
              <%= link_to admin_nav_path(item), target: "_blank", rel: "noopener", class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-surface-container-high" do %>
                <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary-container text-on-primary-container shrink-0"><%= admin_icon(item[:icon], css_class: "w-4 h-4") %></span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-on-surface"><%= item[:title] %></span>
                  <span class="block text-xs text-on-surface-variant truncate"><%= item[:description] %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
