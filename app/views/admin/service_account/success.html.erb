<%= render "admin/shared/page_header", title: "Authorization Successful", back: [ "Service account", admin_service_account_index_path ] %>

<div class="max-w-3xl space-y-6">
  <p role="status" class="px-4 py-3 rounded-xl text-sm <%= AdminHelper::BADGE_TONES[:success] %>">Google returned OAuth tokens for the service account.</p>

  <%= render "admin/shared/card", title: "Refresh token" do %>
    <label class="m3-label" for="refresh-token-input">Copy this token into the credentials</label>
    <div class="flex flex-col sm:flex-row gap-2">
      <input type="text" readonly autocomplete="off" id="refresh-token-input" value="<%= @refresh_token %>" class="m3-input font-mono">
      <%= render "admin/shared/copy_button", value: @refresh_token %>
    </div>
    <label class="m3-label mt-4" for="access-token-input">Access token (for reference only)</label>
    <input type="text" readonly autocomplete="off" id="access-token-input" value="<%= @access_token&.first(50) %>…" class="m3-input font-mono">
  <% end %>

  <%= render "admin/shared/card", title: "Next steps" do %>
    <ol class="list-decimal list-inside space-y-1 text-sm text-on-surface-variant">
      <li>Copy the refresh token above.</li>
      <li>Edit the credentials: <code class="px-1 rounded bg-surface-container-high font-mono">EDITOR=nano rails credentials:edit</code></li>
      <li>Add <code class="px-1 rounded bg-surface-container-high font-mono">google: service_account_oauth_refresh_token: "…"</code></li>
      <li>Save, exit, and restart the server.</li>
    </ol>
  <% end %>
</div>
