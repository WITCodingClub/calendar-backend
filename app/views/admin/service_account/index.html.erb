<%= render "admin/shared/page_header", title: "Service Account", subtitle: "The Google OAuth token the app uses for its own calendar work." %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%= render "admin/shared/card", title: "Current status" do %>
    <%= admin_details(columns: 1) do |d| %>
      <% d.item("Service account email") { @service_account_email || "Not configured" } %>
      <% d.item("OAuth refresh token") { @has_oauth_token ? admin_badge("Configured", :success) : admin_badge("Not configured", :danger) } %>
    <% end %>
    <div class="mt-6 flex flex-col sm:flex-row gap-2">
      <%= link_to "Authorize with Google", admin_service_account_authorize_path, class: "m3-btn-filled justify-center" %>
      <%= button_to "Revoke access", admin_service_account_revoke_path, method: :post, class: "m3-btn-outlined justify-center w-full" %>
    </div>
  <% end %>

  <%= render "admin/shared/card", title: "Before you start" do %>
    <p class="text-sm text-on-surface-variant">Add this redirect URI to the OAuth client in Google Cloud Console:</p>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <code class="px-2 py-1 rounded bg-surface-container-high font-mono text-xs break-all"><%= request.base_url %>/admin/oauth/callback</code>
      <%= render "admin/shared/copy_button", value: "#{request.base_url}/admin/oauth/callback" %>
    </div>
    <ol class="mt-4 list-decimal list-inside space-y-1 text-sm text-on-surface-variant">
      <li>Add the redirect URI above in Google Cloud Console.</li>
      <li>Click "Authorize with Google" and sign in as the service account.</li>
      <li>Copy the refresh token that the next page shows.</li>
      <li>Add it to the credentials with <code class="px-1 rounded bg-surface-container-high font-mono">rails credentials:edit</code>.</li>
    </ol>
  <% end %>
</div>
