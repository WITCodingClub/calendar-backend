<%= render "admin/shared/page_header", title: "Calendar Events", subtitle: "Events the app wrote to user calendars, newest first." %>

<%= admin_table(@calendar_events, empty: "No calendar events yet.") do |t| %>
  <% t.column("Event ID") { |event| tag.span(event.external_event_id&.truncate(24), title: event.external_event_id, class: "font-mono text-xs") } %>
  <% t.column("Calendar") { |event| event.course_calendar&.summary } %>
  <% t.column("Source") do |event| %>
    <% if event.meeting_time_id %>
      <%= admin_badge("Class", :info) %>
    <% elsif event.final_exam_id %>
      <%= admin_badge("Final exam", :warning) %>
    <% elsif event.university_calendar_event_id %>
      <%= admin_badge("University event", :success) %>
    <% end %>
  <% end %>
  <% t.column("Data hash") { |event| tag.span(event.event_data_hash&.first(12), class: "font-mono text-xs text-on-surface-variant") } %>
  <% t.column("Created") { |event| event.created_at.strftime("%b %-d, %Y") } %>
<% end %>
