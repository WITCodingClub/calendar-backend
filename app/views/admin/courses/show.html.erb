<%= render "admin/shared/page_header",
    title: "#{@course.subject} #{@course.course_number}",
    subtitle: @course.title,
    back: [ "Courses", admin_courses_path ] %>

<div class="space-y-6">
  <%= render "admin/shared/card", title: "Details" do %>
    <%= admin_details(columns: 3) do |d| %>
      <% d.item("CRN") { @course.crn } %>
      <% d.item("Term") { link_to @course.term.name, admin_term_path(@course.term), class: "text-primary hover:underline" } %>
      <% d.item("Section") { @course.section_number } %>
      <% d.item("Credits") { @course.credit_hours } %>
      <% d.item("Instructors", wide: true) do %>
        <% if @course.faculties.any? %>
          <%= safe_join(@course.faculties.map { |f| link_to f.full_name, admin_faculty_path(f), class: "text-primary hover:underline" }, ", ") %>
        <% else %>
          TBA
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% relations = Catalog::CourseRelations.new(@course) %>
  <%= render "admin/shared/card", title: "Related courses" do %>
    <%= admin_details(columns: 2) do |d| %>
      <% d.item("Prerequisites", wide: true) do %>
        <%= render "admin/courses/requisite", node: relations.prerequisites, relations: relations if relations.prerequisites %>
      <% end %>
      <% d.item("Corequisites") do %>
        <%= safe_join(relations.corequisites.map { |ref| render("admin/courses/course_code", relations: relations, subject_code: ref["subject_code"], course_number: ref["course_number"]) }, ", ") %>
      <% end %>
      <% d.item("Prerequisite for") do %>
        <%= safe_join(relations.unlocks.map { |unlocked| render("admin/courses/course_code", relations: relations, subject_code: unlocked.subject_code, course_number: unlocked.course_number) }, ", ") %>
      <% end %>
      <% d.item("Linked sections", wide: true) do %>
        <% relations.linked_options.each_with_index do |group, index| %>
          <div>
            <% if relations.linked_options.size > 1 %><span class="text-xs text-on-surface-variant">Option <%= index + 1 %>:</span><% end %>
            <%= safe_join(group.map { |section| link_to("#{section.prefix} #{section.course_number} (#{section.section_number}) · CRN #{section.crn}", admin_course_path(section), class: "text-primary hover:underline whitespace-nowrap", title: section.title) }, " + ") %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <% if relations.catalog_course.nil? %>
      <p class="mt-3 text-xs text-on-surface-variant">No catalog details for this course yet. Catalog::CourseDetailsSync stores the prerequisites and corequisites.</p>
    <% end %>
  <% end %>

  <% meeting_times = @course.meeting_times.to_a %>
  <%= render "admin/shared/card", title: "Meeting times", subtitle: pluralize(meeting_times.size, "meeting time"), flush: true do %>
    <%= admin_table(meeting_times, card: false, empty: "No meeting times scheduled.") do |t| %>
      <% t.column("Day") { |mt| mt.day_of_week&.capitalize || "TBA" } %>
      <% t.column("Time") { |mt| mt.begin_time && mt.end_time ? mt.formatted_time_range : "TBA" } %>
      <% t.column("Location") { |mt| mt.building_room.presence || "TBA" } %>
      <% t.column("Dates") { |mt| "#{mt.start_date.strftime('%m/%d')} – #{mt.end_date.strftime('%m/%d/%Y')}" if mt.start_date && mt.end_date } %>
    <% end %>
  <% end %>

  <% enrollments = @course.enrollments.includes(:user).to_a %>
  <%= render "admin/shared/card", title: "Enrolled students", subtitle: pluralize(enrollments.size, "student"), flush: true do %>
    <%= admin_table(enrollments, card: false, empty: "No students enrolled.") do |t| %>
      <% t.column("Student") { |enrollment| link_to enrollment.user.full_name, admin_user_path(enrollment.user), class: "font-medium text-primary hover:underline" } %>
      <% t.column("Email") { |enrollment| enrollment.user.email } %>
    <% end %>
  <% end %>
</div>
