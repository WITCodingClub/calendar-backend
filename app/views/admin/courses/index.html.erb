<%= render "admin/shared/page_header", title: "Courses", subtitle: "Every course section from LeopardWeb, newest first." %>

<%= render "admin/shared/filters",
    url: admin_courses_path,
    search: "Search by title or subject",
    selects: [ { name: :term_id, label: "Term", options: @terms.map { |term| [ term.name, term.id ] }, blank: "All terms" } ] %>

<%= admin_table(@courses, empty: "No courses match.") do |t| %>
  <% t.column("Course") do |course| %>
    <%= link_to "#{course.subject} #{course.course_number}", admin_course_path(course), class: "font-medium text-primary hover:underline whitespace-nowrap" %>
    <div class="text-xs text-on-surface-variant">CRN <%= course.crn %></div>
  <% end %>
  <% t.column("Title") { |course| course.title } %>
  <% t.column("Faculty") { |course| course.faculties.map(&:full_name).join(", ") } %>
  <% t.column("Term") { |course| course.term&.name } %>
<% end %>
