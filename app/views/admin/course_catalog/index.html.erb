<%= render "admin/shared/page_header", title: "Course Catalog", subtitle: "Import course data from LeopardWeb for each term. Provision a term that is only in the API before you import it." %>

<%# The frame reloads every five seconds, so a running import updates in place. %>
<%= turbo_frame_tag "import-statuses",
    data: { controller: "auto-refresh", "auto-refresh-interval-value": 5000, "auto-refresh-url-value": request.path } do %>
  <%= admin_table(@combined_terms, empty: "LeopardWeb returned no terms, and the database has none.") do |t| %>
    <% t.column("Term") do |term_data| %>
      <span class="font-medium"><%= term_data[:description] %></span>
      <div class="text-xs text-on-surface-variant"><code><%= term_data[:uid] %></code></div>
    <% end %>
    <% t.column("Source") do |term_data| %>
      <% if term_data[:in_database] && term_data[:from_api] %>
        <%= admin_badge("In DB + API", :success) %>
      <% elsif term_data[:in_database] %>
        <%= admin_badge("In DB only", :neutral) %>
      <% else %>
        <%= admin_badge("API only", :warning) %>
      <% end %>
    <% end %>
    <% t.column("Import status") do |term_data| %>
      <% db_term = term_data[:db_term] %>
      <% if db_term&.catalog_importing? %>
        <%= admin_badge("Importing…", :info) %>
      <% elsif db_term&.catalog_import_failed? %>
        <% job_id = db_term.catalog_import_job_id %>
        <%= link_to (job_id ? admin_mission_control_jobs.application_job_path("calendar", job_id, anchor: "error") : admin_mission_control_jobs.root_path),
            data: { turbo_frame: "_top" }, class: "hover:underline" do %>
          <%= admin_badge("Failed", :danger) %>
        <% end %>
      <% elsif db_term&.catalog_imported? %>
        <%= admin_badge("Imported #{time_ago_in_words(db_term.catalog_imported_at)} ago", :success) %>
      <% elsif term_data[:in_database] %>
        <%= admin_badge("Not imported") %>
      <% end %>
    <% end %>
    <% t.column("Actions", align: :right, primary: false) do |term_data| %>
      <% if term_data[:in_database] && term_data[:from_api] %>
        <% importing = term_data[:db_term]&.catalog_importing? %>
        <%= button_to (importing ? "Importing…" : (term_data[:db_term]&.catalog_imported? ? "Re-import" : "Import")),
            admin_course_catalog_import_path(term_uid: term_data[:uid]),
            method: :post,
            disabled: importing,
            form: { data: { turbo_frame: "_top", turbo_confirm: ("Import courses for #{term_data[:description]}?" unless importing) }.compact },
            class: "m3-btn-outlined disabled:opacity-50 disabled:cursor-not-allowed" %>
      <% elsif !term_data[:in_database] %>
        <%= button_to "Provision",
            admin_course_catalog_provision_path(term_uid: term_data[:uid], description: term_data[:description]),
            method: :post,
            form: { data: { turbo_frame: "_top", turbo_confirm: "Create term #{term_data[:description]} in database?" } },
            class: "m3-btn-tonal" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<p class="mt-4 flex items-start gap-2 text-sm text-on-surface-variant">
  <%= admin_icon(:information, css_class: "w-5 h-5 shrink-0") %>
  <span>Imports run in the background and can take a few minutes. <%= link_to "Background Jobs", admin_mission_control_jobs_path, target: "_blank", rel: "noopener", class: "text-primary underline" %> shows the job status.</span>
</p>
