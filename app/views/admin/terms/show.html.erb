<%= render "admin/shared/page_header", title: @term.name, subtitle: "Term #{@term.uid}", back: [ "Terms", admin_terms_path ] %>

<%= render "admin/shared/card", title: "Courses", subtitle: pluralize(@courses.total_count, "course"), flush: true do %>
  <%= admin_table(@courses, card: false, empty: "No courses in this term.") do |t| %>
    <% t.column("Course") do |course| %>
      <%= link_to "#{course.subject} #{course.course_number}", admin_course_path(course), class: "font-medium text-primary hover:underline whitespace-nowrap" %>
      <div class="text-xs text-on-surface-variant">CRN <%= course.crn %> · Section <%= course.section_number %></div>
    <% end %>
    <% t.column("Title") { |course| course.title } %>
    <% t.column("Instructor") { |course| safe_join(course.faculties.map { |f| link_to f.full_name, admin_faculty_path(f), class: "text-primary hover:underline" }, ", ") } %>
    <% t.column("Location") { |course| course.meeting_times.filter_map(&:building_room).uniq.join(", ") } %>
  <% end %>
<% end %>
