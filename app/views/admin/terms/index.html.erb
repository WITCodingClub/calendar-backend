<%= render "admin/shared/page_header", title: "Terms", subtitle: "Academic terms, newest first." %>

<%= admin_table(@terms, empty: "No terms yet.") do |t| %>
  <% t.column("Term") { |term| link_to term.name, admin_term_path(term), class: "font-medium text-primary hover:underline" } %>
  <% t.column("UID") { |term| tag.code(term.uid, class: "text-xs") } %>
  <% t.column("Courses", align: :right) { |term| number_with_delimiter(@course_counts.fetch(term.id, 0)) } %>
  <% t.column("Catalog") do |term| %>
    <% if term.catalog_importing? %>
      <%= admin_badge("Importing…", :info) %>
    <% elsif term.catalog_import_failed? %>
      <%= admin_badge("Import failed", :danger) %>
    <% elsif term.catalog_imported? %>
      <%= admin_badge("Imported", :success) %>
    <% else %>
      <%= admin_badge("Not imported") %>
    <% end %>
  <% end %>
<% end %>
