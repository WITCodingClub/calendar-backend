<%= render "admin/shared/page_header", title: "Directory Sync Status", back: [ "Faculty", admin_faculties_path ] do %>
  <%= render "directory_sync_button" %>
<% end %>

<%= render "admin/shared/stats", columns: 6 do %>
  <%= render "admin/shared/stat", label: "Total records", value: @total_count %>
  <%= render "admin/shared/stat", label: "Synced", value: @synced_count, tone: :success %>
  <%= render "admin/shared/stat", label: "Not synced", value: @unsynced_count, tone: (@unsynced_count.positive? ? :warning : nil) %>
  <%= render "admin/shared/stat", label: "Faculty", value: @faculty_count %>
  <%= render "admin/shared/stat", label: "Staff", value: @staff_count %>
  <%= render "admin/shared/stat", label: "Coverage", value: @total_count.positive? ? number_to_percentage(@synced_count * 100.0 / @total_count, precision: 0) : "0%" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%= render "admin/shared/card", title: "Sync information" do %>
    <%= admin_details(columns: 1) do |d| %>
      <% d.item("Last directory sync") do %>
        <% if @last_sync %>
          <%= l(@last_sync, format: :long) %> <span class="text-on-surface-variant">(<%= time_ago_in_words(@last_sync) %> ago)</span>
        <% else %>
          <%= admin_badge("Never synced", :warning) %>
        <% end %>
      <% end %>
      <% d.item("Source") { link_to "wit.edu/faculty-staff-directory", "https://wit.edu/faculty-staff-directory", target: "_blank", rel: "noopener noreferrer", class: "text-primary hover:underline" } %>
    <% end %>
  <% end %>

  <%= render "admin/shared/card", title: "About directory sync" do %>
    <div class="text-sm text-on-surface-variant space-y-2">
      <p>The sync reads the WIT faculty directory: full name, job title, email, phone, office, department, school, and photo.</p>
      <p><strong class="text-on-surface">Automatic:</strong> when a course import adds a new faculty member, the app reads that person's directory entry.</p>
      <p><strong class="text-on-surface">Manual:</strong> "Sync directory" refreshes every faculty and staff record.</p>
    </div>
  <% end %>
</div>
