<%= render "admin/shared/page_header", title: "Faculty & Staff", subtitle: "People from LeopardWeb courses and the WIT directory." do %>
  <%= render "directory_sync_button" %>
  <%= link_to "Directory status", directory_status_admin_faculties_path, class: "m3-btn-outlined" %>
  <%= link_to "Missing RMP IDs", missing_rmp_ids_admin_faculties_path, class: "m3-btn-outlined" %>
<% end %>

<%= render "admin/shared/stats" do %>
  <%= render "admin/shared/stat", label: "Total", value: @stats[:total] %>
  <%= render "admin/shared/stat", label: "Faculty", value: @stats[:faculty] %>
  <%= render "admin/shared/stat", label: "Staff", value: @stats[:staff] %>
  <%= render "admin/shared/stat", label: "Directory synced", value: @stats[:synced], path: directory_status_admin_faculties_path %>
<% end %>

<%= render "admin/shared/filters",
    url: admin_faculties_path,
    search: "Search by name, email, or department",
    selects: [ { name: :employee_type, label: "Type", options: [ %w[Faculty faculty], %w[Staff staff] ], blank: "All types" } ] %>

<%= admin_table(@faculties, empty: "No faculty or staff match.") do |t| %>
  <% t.column("Name") do |faculty| %>
    <div class="flex items-center gap-3">
      <%= render "avatar", faculty: faculty %>
      <div class="min-w-0">
        <%= link_to faculty.full_name, admin_faculty_path(faculty), class: "font-medium text-primary hover:underline" %>
        <% if faculty.office_location.present? %>
          <div class="text-xs text-on-surface-variant"><%= faculty.office_location %></div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% t.column("Title") { |faculty| faculty.title } %>
  <% t.column("Department") { |faculty| faculty.department || faculty.school } %>
  <% t.column("Email") { |faculty| mail_to(faculty.email, faculty.email, class: "text-primary hover:underline break-all") if faculty.email } %>
  <% t.column("Type") { |faculty| render "type_badge", faculty: faculty } %>
<% end %>
