<% service = Faculties::RateMyProfessorClient.new %>
<% directory_url = service.faculty_directory_url(first_name: @faculty.first_name, last_name: @faculty.last_name) %>
<% rmp_url = service.add_professor_url %>

<%= render "admin/shared/page_header",
    title: "Search Rate My Professor",
    subtitle: "#{@faculty.full_name} · #{@faculty.email || 'no email'} · #{pluralize(@faculty.courses.count, 'course')}",
    back: [ "Missing RMP IDs", missing_rmp_ids_admin_faculties_path ] %>

<div class="space-y-4">
  <% if @teachers.empty? %>
    <div class="m3-card px-4 py-8">
      <%= render "admin/shared/empty_state", icon: :search, message: "Rate My Professor has no match for “#{@faculty.full_name}”." %>
    </div>
  <% else %>
    <p class="text-sm text-on-surface-variant"><%= pluralize(@teachers.size, "result") %> on Rate My Professor.</p>
    <% @teachers.each do |edge| %>
      <% teacher = edge["node"] %>
      <% exact = teacher["firstName"]&.downcase&.strip == @faculty.first_name&.downcase&.strip &&
                 teacher["lastName"]&.downcase&.strip == @faculty.last_name&.downcase&.strip %>
      <section class="m3-card p-4 sm:p-6 <%= "ring-2 ring-primary" if exact %>">
        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
          <div class="flex-1 min-w-0">
            <h2 class="flex flex-wrap items-center gap-2 text-lg font-semibold text-on-surface">
              <%= teacher["firstName"] %> <%= teacher["lastName"] %>
              <%= admin_badge("Exact name match", :success) if exact %>
            </h2>
            <div class="mt-3">
              <%= admin_details(columns: 3) do |d| %>
                <% d.item("School") { teacher.dig("school", "name") || "Unknown school" } %>
                <% d.item("Department") { teacher["department"] || "Unknown department" } %>
                <% d.item("RMP ID") { tag.code(teacher["id"], class: "text-xs") } %>
                <% d.item("Rating") { teacher["avgRating"] ? "#{teacher['avgRating']} / 5.0 (#{teacher['numRatings'] || 0} ratings)" : "N/A" } %>
                <% d.item("Difficulty") { teacher["avgDifficulty"] ? "#{teacher['avgDifficulty']} / 5.0" : "N/A" } %>
              <% end %>
            </div>
          </div>
          <%= button_to "Assign this ID", assign_rmp_id_admin_faculty_path(@faculty, rmp_id: teacher["id"]),
              method: :post,
              form: { data: { turbo_confirm: "Assign RMP ID '#{teacher['id']}' to #{@faculty.full_name}?" } },
              class: "m3-btn-filled justify-center" %>
        </div>
      </section>
    <% end %>
  <% end %>

  <%= render "admin/shared/card", title: (@teachers.empty? ? "Add this professor to RMP" : "None of these match?") do %>
    <ol class="list-decimal list-inside space-y-2 text-sm text-on-surface-variant">
      <li>Open the <%= link_to "WIT faculty directory entry", directory_url, target: "_blank", rel: "noopener noreferrer", class: "text-primary underline" %>.</li>
      <li>Open the <%= link_to "RMP add professor form", rmp_url, target: "_blank", rel: "noopener noreferrer", class: "text-primary underline" %>.</li>
      <li>Copy into the form: <strong class="text-on-surface"><%= @faculty.full_name %></strong>, Wentworth Institute of Technology, and the directory URL.</li>
    </ol>
  <% end %>
</div>
