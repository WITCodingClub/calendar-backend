<%= render "admin/shared/page_header", title: @faculty.full_name, subtitle: @faculty.title, back: [ "Faculty", admin_faculties_path ] %>

<div class="space-y-6">
  <%= render "admin/shared/card" do %>
    <div class="flex flex-col sm:flex-row gap-6">
      <%= render "avatar", faculty: @faculty, size: "h-24 w-24 text-2xl" %>
      <div class="flex-1">
        <%= admin_details(columns: 3) do |d| %>
          <% d.item("Email") { mail_to(@faculty.email, @faculty.email, class: "text-primary hover:underline") if @faculty.email } %>
          <% d.item("Phone") { @faculty.phone } %>
          <% d.item("Office") { @faculty.office_location } %>
          <% d.item("Department") { @faculty.department } %>
          <% d.item("School") { @faculty.school } %>
          <% d.item("Type") { render "type_badge", faculty: @faculty } %>
          <% d.item("Directory sync") do %>
            <% if @faculty.directory_last_synced_at %>
              <%= admin_badge("Synced #{time_ago_in_words(@faculty.directory_last_synced_at)} ago", :success) %>
            <% else %>
              <%= admin_badge("Not synced", :warning) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "admin/shared/stats" do %>
    <%= render "admin/shared/stat", label: "Courses", value: @course_count %>
    <% if @rmp_ratings.present? %>
      <% avg_rating = @rmp_ratings.average(:clarity_rating) %>
      <% avg_difficulty = @rmp_ratings.average(:difficulty_rating) %>
      <%= render "admin/shared/stat", label: "RMP ratings", value: @rmp_ratings.size %>
      <%= render "admin/shared/stat", label: "Avg rating", value: avg_rating ? number_with_precision(avg_rating, precision: 1) : "N/A" %>
      <%= render "admin/shared/stat", label: "Avg difficulty", value: avg_difficulty ? number_with_precision(avg_difficulty, precision: 1) : "N/A" %>
    <% end %>
  <% end %>

  <% if @faculty.rmp_id.present? || policy(@faculty).search_rmp? %>
    <% rmp_actions = capture do %>
      <% if @faculty.rmp_id.blank? && policy(@faculty).auto_fill_rmp_id? %>
        <%= button_to "Auto search", auto_fill_rmp_id_admin_faculty_path(@faculty), method: :post, class: "m3-btn-tonal" %>
      <% end %>
      <% if policy(@faculty).search_rmp? %>
        <%= link_to (@faculty.rmp_id.present? ? "Search RMP" : "Manual search"), search_rmp_admin_faculty_path(@faculty), class: "m3-btn-outlined" %>
      <% end %>
    <% end %>
    <%= render "admin/shared/card", title: "Rate My Professor", actions: rmp_actions do %>
      <p class="text-sm text-on-surface-variant">
        <% if @faculty.rmp_id.present? %>
          RMP ID: <code class="font-mono"><%= @faculty.rmp_id %></code>
        <% else %>
          Not linked to Rate My Professor.
        <% end %>
      </p>
    <% end %>
  <% end %>

  <% if @courses_by_term.empty? %>
    <div class="m3-card px-4 py-10">
      <%= render "admin/shared/empty_state", message: "No courses found." %>
    </div>
  <% else %>
    <% @courses_by_term.each do |term, courses| %>
      <%= render "admin/shared/card", title: term.name, subtitle: pluralize(courses.size, "course"), flush: true do %>
        <%= admin_table(courses, card: false) do |t| %>
          <% t.column("Course") do |course| %>
            <%= link_to "#{course.subject} #{course.course_number}", admin_course_path(course), class: "font-medium text-primary hover:underline whitespace-nowrap" %>
            <div class="text-xs text-on-surface-variant">Section <%= course.section_number %></div>
          <% end %>
          <% t.column("Title") { |course| course.title } %>
          <% t.column("Meeting times") do |course| %>
            <% course.meeting_times.each do |mt| %>
              <div class="whitespace-nowrap"><%= mt.day_of_week&.capitalize %> <%= mt.formatted_time_range %> <%= "(#{mt.building_room})" if mt.building_room.present? %></div>
            <% end %>
          <% end %>
          <% t.column("Credits", align: :right) { |course| course.credit_hours&.to_s } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
