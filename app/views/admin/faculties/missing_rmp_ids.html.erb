<%= render "admin/shared/page_header",
    title: "Professors Missing RMP IDs",
    subtitle: "#{pluralize(@faculties.total_count, 'professor')} with courses and no Rate My Professor ID.",
    back: [ "Faculty", admin_faculties_path ] do %>
  <% if @faculties.any? && policy(Faculty).batch_auto_fill? %>
    <%= button_to "Auto-fill all", batch_auto_fill_admin_faculties_path,
        method: :post,
        form: { data: { turbo_confirm: "This will queue background jobs to search Rate My Professor for all #{@faculties.total_count} faculty members. Continue?" } },
        class: "m3-btn-filled" %>
  <% end %>
<% end %>

<%= render "admin/shared/search", url: missing_rmp_ids_admin_faculties_path, placeholder: "Search by name" %>

<%= admin_table(@faculties, empty: "Every professor with courses has an RMP ID.") do |t| %>
  <% t.column("Name") { |faculty| link_to faculty.full_name, admin_faculty_path(faculty), class: "font-medium text-primary hover:underline" } %>
  <% t.column("Email") { |faculty| faculty.email } %>
  <% t.column("Courses", align: :right) { |faculty| @course_counts.fetch(faculty.id, 0).to_s } %>
  <% t.column("Actions", align: :right, primary: false) do |faculty| %>
    <div class="admin-actions inline-flex flex-wrap justify-end gap-1">
      <% if policy(faculty).auto_fill_rmp_id? %>
        <%= button_to "Auto search", auto_fill_rmp_id_admin_faculty_path(faculty), method: :post, class: "m3-btn-tonal px-3 py-1" %>
      <% end %>
      <% if policy(faculty).search_rmp? %>
        <%= link_to "Manual search", search_rmp_admin_faculty_path(faculty), class: "m3-btn-outlined px-3 py-1" %>
      <% end %>
    </div>
  <% end %>
<% end %>
