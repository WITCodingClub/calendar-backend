<%# While the schedule is pending or processing, the frame reloads every
    three seconds. %>
<%= turbo_frame_tag "finals_schedule_#{@finals_schedule.id}",
    data: (@finals_schedule.pending? || @finals_schedule.processing?) ? { controller: "auto-refresh", "auto-refresh-interval-value": 3000 } : {} do %>
  <%= render "admin/shared/page_header",
      title: "Finals Schedule: #{@finals_schedule.term.name}",
      back: [ "Finals schedules", admin_finals_schedules_path ] do %>
    <% if policy(@finals_schedule).destroy? %>
      <%= button_to "Delete schedule", admin_finals_schedule_path(@finals_schedule),
          method: :delete,
          form: { data: { turbo_frame: "_top", turbo_confirm: "Delete this finals schedule? This will NOT delete the associated final exams." } },
          class: "m3-btn-danger" %>
    <% end %>
  <% end %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <%= render "admin/shared/card", title: "Upload" do %>
        <%= admin_details do |d| %>
          <% d.item("Status") { render "status_badge", status: @finals_schedule.status } %>
          <% d.item("Uploaded by") { @finals_schedule.uploaded_by.email } %>
          <% d.item("Uploaded") { @finals_schedule.created_at.strftime("%b %-d, %Y %-l:%M %p") } %>
          <% d.item("Processed") { @finals_schedule.processed_at&.strftime("%b %-d, %Y %-l:%M %p") } %>
          <% if @finals_schedule.pdf_file.attached? %>
            <% d.item("PDF file", wide: true) do %>
              <%= link_to "Download PDF", rails_blob_path(@finals_schedule.pdf_file, disposition: "attachment"), data: { turbo_frame: "_top" }, class: "text-primary hover:underline" %>
              <span class="text-xs text-on-surface-variant">(<%= number_to_human_size(@finals_schedule.pdf_file.blob.byte_size) %>)</span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= render "admin/shared/card", title: "Processing results" do %>
        <% if @finals_schedule.stats.present? %>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <%= render "admin/shared/stat", label: "Created", value: @finals_schedule.stats["created"] || 0, tone: :success %>
            <%= render "admin/shared/stat", label: "Updated", value: @finals_schedule.stats["updated"] || 0, tone: :info %>
            <%= render "admin/shared/stat", label: "Total parsed", value: @finals_schedule.stats["total"] || 0 %>
            <%= render "admin/shared/stat", label: "Linked", value: @final_exams.count(&:linked?) %>
            <%= render "admin/shared/stat", label: "Awaiting courses", value: @final_exams.count(&:orphan?), tone: :warning %>
          </div>
        <% elsif @finals_schedule.pending? || @finals_schedule.processing? %>
          <p class="text-sm text-on-surface-variant">Processing. This page updates by itself.</p>
        <% else %>
          <p class="text-sm text-on-surface-variant">No statistics available.</p>
        <% end %>
      <% end %>
    </div>

    <% if @finals_schedule.error_message.present? %>
      <%= render "admin/shared/card", title: "Errors and warnings", subtitle: pluralize(@finals_schedule.error_message.lines.count, "message") do %>
        <pre class="max-h-64 overflow-y-auto whitespace-pre-wrap font-mono text-xs text-error"><%= @finals_schedule.error_message %></pre>
      <% end %>
    <% end %>

    <%= render "admin/shared/card", title: "Final exams", subtitle: pluralize(@final_exams.size, "exam"), flush: true do %>
      <div class="max-h-[32rem] overflow-y-auto">
        <%= render "exams_table", exams: @final_exams %>
      </div>
    <% end %>
  </div>
<% end %>
