<%= render "admin/shared/page_header", title: "Confirm Schedule Update", back: [ "Finals schedules", admin_finals_schedules_path ] %>

<div class="max-w-4xl space-y-6">
  <div class="px-4 py-3 rounded-xl text-sm <%= Admin::ApplicationHelper::BADGE_TONES[:warning] %>">
    <p class="font-semibold">Existing finals found</p>
    <p><%= @finals_schedule.term&.name %> already has <strong><%= @existing_exams.size %></strong> final exams. Processing the new schedule updates the matching CRNs and adds new ones.</p>
  </div>

  <%= render "admin/shared/card", title: "Uploaded file" do %>
    <p class="text-sm"><strong><%= @finals_schedule.pdf_file.filename %></strong> (<%= number_to_human_size(@finals_schedule.pdf_file.blob.byte_size) %>)</p>
  <% end %>

  <%= render "admin/shared/card", title: "Current final exams", subtitle: pluralize(@existing_exams.size, "exam"), flush: true do %>
    <div class="max-h-96 overflow-y-auto">
      <%= render "exams_table", exams: @existing_exams %>
    </div>
  <% end %>

  <%= render "admin/shared/card", title: "What will happen" do %>
    <ul class="list-disc list-inside text-sm space-y-1">
      <li>Exams with <strong>matching CRNs</strong> get the new date, time, and location.</li>
      <li>Exams for <strong>new CRNs</strong> are created.</li>
      <li>Exams for CRNs <strong>not in the new PDF</strong> do not change.</li>
    </ul>
    <div class="mt-6 flex flex-col-reverse sm:flex-row gap-2">
      <%= button_to "Cancel upload", admin_finals_schedule_path(@finals_schedule),
          method: :delete,
          form: { data: { turbo_confirm: "Cancel upload and delete the pending schedule?" } },
          class: "m3-btn-outlined justify-center w-full sm:w-auto" %>
      <%= button_to "Confirm and process schedule", process_schedule_admin_finals_schedule_path(@finals_schedule),
          method: :post, class: "m3-btn-filled justify-center w-full sm:w-auto" %>
    </div>
  <% end %>
</div>
