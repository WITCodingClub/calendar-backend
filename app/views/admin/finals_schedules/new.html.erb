<%= render "admin/shared/page_header", title: "Upload Finals Schedule", back: [ "Finals schedules", admin_finals_schedules_path ] %>

<%= render "admin/shared/card", css_class: "max-w-2xl" do %>
  <%= form_with model: [ :admin, @finals_schedule ], class: "space-y-6" do |f| %>
    <%= render "admin/shared/form_errors", record: @finals_schedule %>

    <fieldset data-controller="term-filter">
      <legend class="m3-label">Term</legend>
      <label class="sr-only" for="term-filter-search">Filter terms</label>
      <input id="term-filter-search" type="search" autocomplete="off" placeholder="Type to filter terms"
             data-term-filter-target="search" data-action="input->term-filter#filter"
             class="m3-input mb-2">
      <div class="max-h-64 overflow-y-auto rounded-lg border border-outline-variant divide-y divide-outline-variant">
        <% @terms.each do |term| %>
          <label class="flex items-center justify-between gap-3 px-4 py-3 cursor-pointer hover:bg-surface-container-high"
                 data-term-filter-target="option" data-term-name="<%= term.name.downcase %>">
            <span class="flex items-center gap-2">
              <%= f.radio_button :term_id, term.id, class: "h-4 w-4 accent-primary" %>
              <span class="text-sm font-medium"><%= term.name %></span>
            </span>
            <% if term.past? %>
              <%= admin_badge("Retroactive", :warning) %>
            <% elsif term.active? %>
              <%= admin_badge("Current", :success) %>
            <% elsif term.upcoming? %>
              <%= admin_badge("Upcoming", :info) %>
            <% end %>
          </label>
        <% end %>
        <% if @terms.empty? %>
          <p class="px-4 py-3 text-sm text-on-surface-variant">No terms available.</p>
        <% end %>
        <p class="px-4 py-3 text-sm text-on-surface-variant" data-term-filter-target="noResults" hidden>No matching terms found.</p>
      </div>
      <p class="mt-1 text-xs text-on-surface-variant">Select the term this finals schedule is for.</p>
    </fieldset>

    <%= render "admin/shared/form_field", form: f, attribute: :pdf_file, label: "PDF file", hint: "The app reads exam dates, times, and locations from the PDF." do %>
      <%= f.file_field :pdf_file, accept: "application/pdf", required: true, class: "m3-input" %>
    <% end %>

    <div class="flex flex-col-reverse sm:flex-row gap-2">
      <%= link_to "Cancel", admin_finals_schedules_path, class: "m3-btn-outlined justify-center" %>
      <%= f.button "Upload and process", type: "submit", class: "m3-btn-filled justify-center" %>
    </div>
  <% end %>
<% end %>
