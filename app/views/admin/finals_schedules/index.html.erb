<%= render "admin/shared/page_header", title: "Finals Schedules", subtitle: "Uploaded finals PDFs and their processing results." do %>
  <% if policy(FinalsSchedule).create? %>
    <%= link_to new_admin_finals_schedule_path, class: "m3-btn-filled" do %>
      <%= admin_icon(:plus, css_class: "w-4 h-4") %> Upload schedule
    <% end %>
  <% end %>
<% end %>

<%= render "admin/shared/filters",
    url: admin_finals_schedules_path,
    selects: [ { name: :term_id, label: "Term", options: @terms.map { |term| [ term.name, term.id ] }, blank: "All terms" } ] %>

<%= admin_table(@finals_schedules, empty: "No finals schedules uploaded yet.") do |t| %>
  <% t.column("Term") { |schedule| link_to schedule.term.name, admin_finals_schedule_path(schedule), class: "font-medium text-primary hover:underline" } %>
  <% t.column("Status") { |schedule| render "status_badge", status: schedule.status } %>
  <% t.column("Uploaded") do |schedule| %>
    <%= schedule.created_at.strftime("%b %-d, %Y %-l:%M %p") %>
    <div class="text-xs text-on-surface-variant break-all"><%= schedule.uploaded_by.email %></div>
  <% end %>
  <% t.column("Results") do |schedule| %>
    <% if schedule.stats.present? %>
      <%= schedule.stats["created"] || 0 %> created · <%= schedule.stats["updated"] || 0 %> updated · <%= schedule.stats["skipped"] || 0 %> skipped
    <% end %>
  <% end %>
  <% t.column("Actions", align: :right, primary: false) do |schedule| %>
    <% if policy(schedule).destroy? %>
      <%= button_to "Delete", admin_finals_schedule_path(schedule),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this finals schedule? This will NOT delete the associated final exams." } },
          class: "m3-btn-text text-error" %>
    <% end %>
  <% end %>
<% end %>
