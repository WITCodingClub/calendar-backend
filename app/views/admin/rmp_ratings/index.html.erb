<%= render "admin/shared/page_header", title: "Rate My Professor Ratings", subtitle: "Ratings read from Rate My Professor, newest first." %>

<%= render "admin/shared/filters",
    url: admin_rmp_ratings_path,
    search: "Search the comments",
    checks: [ { name: :semantic, label: "By meaning" } ] %>

<% if @query.present? && @semantic && !Catalog::SemanticSearch.available? %>
  <p class="mb-4 text-sm text-on-surface-variant">
    Search by meaning is off, so these are the literal matches. Turn on the
    <code>semantic_search</code> flag and set <code>OPENAI_API_KEY</code>.
  </p>
<% end %>

<%= admin_table(@rmp_ratings, empty: "No ratings yet.") do |t| %>
  <% t.column("Faculty") { |rating| link_to(rating.faculty.full_name, admin_faculty_path(rating.faculty), class: "font-medium text-primary hover:underline") if rating.faculty } %>
  <% t.column("Course") { |rating| rating.course_name } %>
  <% t.column("Comment") { |rating| tag.span(truncate(rating.comment, length: 140), class: "block max-w-md") } %>
  <% t.column("Clarity", align: :right) { |rating| rating.clarity_rating&.to_s } %>
  <% t.column("Difficulty", align: :right) { |rating| rating.difficulty_rating&.to_s } %>
  <% t.column("Helpful", align: :right) { |rating| rating.helpful_rating&.to_s } %>
  <% t.column("Would take again") { |rating| rating.would_take_again.nil? ? nil : admin_badge(rating.would_take_again ? "Yes" : "No", rating.would_take_again ? :success : :neutral) } %>
  <% t.column("Added") { |rating| rating.created_at.strftime("%b %-d, %Y") } %>
<% end %>
