<%= render "admin/shared/page_header", title: @event.summary, back: [ "University events", admin_university_calendar_events_path ] %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%= render "admin/shared/card", title: "Event", css_class: "lg:col-span-2" do %>
    <%= admin_details do |d| %>
      <% d.item("Category") { render "category_badge", event: @event } %>
      <% d.item("All day") { @event.all_day ? "Yes" : "No" } %>
      <% d.item("Starts") { @event.all_day ? @event.start_time.strftime("%B %-d, %Y") : @event.start_time.strftime("%B %-d, %Y at %-l:%M %p") } %>
      <% d.item("Ends") { @event.all_day ? @event.end_time.strftime("%B %-d, %Y") : @event.end_time.strftime("%B %-d, %Y at %-l:%M %p") } %>
      <% d.item("Location", wide: true) { @event.location } %>
      <% if @event.description.present? %>
        <% d.item("Description", wide: true) { tag.div(@event.description, class: "whitespace-pre-wrap") } %>
      <% end %>
    <% end %>
  <% end %>

  <div class="space-y-6">
    <%= render "admin/shared/card", title: "Term" do %>
      <%= admin_details(columns: 1) do |d| %>
        <% d.item("Term") { link_to(@event.term.name, admin_term_path(@event.term), class: "text-primary hover:underline") if @event.term } %>
        <% d.item("Academic term (ICS)") { @event.academic_term } %>
        <% d.item("Organization") { @event.organization } %>
      <% end %>
    <% end %>
    <%= render "admin/shared/card", title: "Sync" do %>
      <%= admin_details(columns: 1) do |d| %>
        <% d.item("ICS UID") { tag.span(@event.ics_uid, class: "font-mono text-xs break-all") } %>
        <% d.item("Created") { l(@event.created_at, format: :long) } %>
        <% d.item("Updated") { l(@event.updated_at, format: :long) } %>
      <% end %>
    <% end %>
  </div>
</div>
