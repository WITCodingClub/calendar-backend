<%= render "admin/shared/page_header", title: "University Calendar Events", subtitle: "Events from the university calendar feed." do %>
  <% if policy(UniversityCalendarEvent).sync? %>
    <%= button_to sync_admin_university_calendar_events_path,
        method: :post,
        form: { data: { turbo_confirm: "This will sync events from the university calendar feed. Continue?" } },
        class: "m3-btn-tonal" do %>
      <%= admin_icon(:refresh, css_class: "w-4 h-4") %> Sync now
    <% end %>
  <% end %>
<% end %>

<%= render "admin/shared/stats" do %>
  <%= render "admin/shared/stat", label: "Total events", value: @stats[:total] %>
  <%= render "admin/shared/stat", label: "Holidays", value: @stats[:holidays] %>
  <%= render "admin/shared/stat", label: "Upcoming", value: @stats[:upcoming] %>
  <%= render "admin/shared/stat", label: "Categories", value: @stats[:categories].size %>
<% end %>

<%= render "admin/shared/filters",
    url: admin_university_calendar_events_path,
    search: "Search events",
    selects: [ { name: :category, label: "Category", options: UniversityCalendarEvent::CATEGORIES.map { |c| [ "#{c.titleize} (#{@stats[:categories].fetch(c, 0)})", c ] }, blank: "All categories" } ],
    checks: [ { name: :show_all, label: "Show events without a location" } ] %>

<%= admin_table(@university_calendar_events, empty: "No events match.") do |t| %>
  <% t.row_class { |event| "opacity-60" if event.start_time < Time.current } %>
  <% t.column("Event") do |event| %>
    <%= link_to truncate(event.summary, length: 80), admin_university_calendar_event_path(event), class: "font-medium text-primary hover:underline" %>
    <% if event.location.present? %>
      <div class="text-xs text-on-surface-variant"><%= truncate(event.location, length: 40) %></div>
    <% end %>
  <% end %>
  <% t.column("Category") { |event| render "category_badge", event: event } %>
  <% t.column("When") do |event| %>
    <span class="whitespace-nowrap"><%= event.start_time.strftime("%b %-d, %Y") %></span>
    <div class="text-xs text-on-surface-variant whitespace-nowrap"><%= event.all_day ? "All day" : "#{event.start_time.strftime('%-l:%M %p')} – #{event.end_time.strftime('%-l:%M %p')}" %></div>
  <% end %>
  <% t.column("Term") { |event| event.term&.name || event.academic_term.presence } %>
<% end %>

<% if policy(UniversityCalendarEvent).backfill? %>
  <%= render "admin/shared/card", title: "Backfill past events", subtitle: "Queue a job that reads the feed for a date range.", css_class: "mt-6" do %>
    <%= form_with(url: backfill_admin_university_calendar_events_path, method: :post, class: "flex flex-col sm:flex-row sm:items-end gap-3") do |f| %>
      <div>
        <%= f.label :start_date, "Start date", class: "m3-label" %>
        <%= f.date_field :start_date, required: true, class: "m3-input" %>
      </div>
      <div>
        <%= f.label :end_date, "End date", class: "m3-label" %>
        <%= f.date_field :end_date, required: true, class: "m3-input" %>
      </div>
      <%= f.submit "Queue backfill", class: "m3-btn-outlined justify-center cursor-pointer" %>
    <% end %>
  <% end %>
<% end %>
