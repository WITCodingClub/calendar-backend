<%= render "admin/shared/page_header",
    title: "Room #{@room.number}",
    subtitle: "#{@room.building.name} (#{@room.building.abbreviation})",
    back: [ "Rooms", admin_rooms_path ] %>

<% if @courses_by_term.any? %>
  <div class="space-y-6">
    <% @courses_by_term.each do |term, courses| %>
      <%= render "admin/shared/card", title: term.name, subtitle: pluralize(courses.size, "course"), flush: true do %>
        <%= admin_table(courses, card: false) do |t| %>
          <% t.column("Course") do |course| %>
            <%= link_to course.title, admin_course_path(course), class: "font-medium text-primary hover:underline" %>
            <div class="text-xs text-on-surface-variant">CRN <%= course.crn %></div>
          <% end %>
          <% t.column("Instructor") { |course| course.faculties.map(&:full_name).join(", ").presence || "TBA" } %>
          <% t.column("Meeting times") do |course| %>
            <% course.meeting_times.select { |mt| mt.rooms.any? { |r| r.id == @room.id } }.each do |mt| %>
              <div class="whitespace-nowrap"><%= mt.day_of_week&.capitalize %>: <%= mt.formatted_time_range %></div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="m3-card px-4 py-10">
    <%= render "admin/shared/empty_state", message: "No courses scheduled in this room." %>
  </div>
<% end %>
