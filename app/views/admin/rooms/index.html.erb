<%= render "admin/shared/page_header", title: "Rooms", subtitle: "Rooms by building. Open a room to see the courses in it." %>

<%= render "admin/shared/filters",
    url: admin_rooms_path,
    search: "Search by room number",
    selects: [ { name: :building_id, label: "Building", options: @buildings.map { |b| [ b.name, b.id ] }, blank: "All buildings" } ] %>

<%= admin_table(@rooms, empty: "No rooms match.") do |t| %>
  <% t.column("Room") { |room| link_to room.number, admin_room_path(room), class: "font-medium text-primary hover:underline" } %>
  <% t.column("Building") { |room| "#{room.building.name} (#{room.building.abbreviation})" } %>
  <% t.column("Floor", align: :right) { |room| room.floor.to_s } %>
  <% t.column("Capacity", align: :right) { |room| room.capacity&.to_s } %>
<% end %>
