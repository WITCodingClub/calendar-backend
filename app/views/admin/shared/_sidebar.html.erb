<% categories = Admin::NavigationRegistry.categories_for(current_user) %>

<%# Desktop: a fixed sidebar from the lg breakpoint up. %>
<aside class="hidden lg:flex flex-col fixed inset-y-0 left-0 w-64 z-30 border-r border-outline-variant bg-surface-container">
  <%= render "admin/shared/brand" %>
  <%= render "admin/shared/nav", categories: categories %>
  <%= render "admin/shared/sidebar_footer" %>
</aside>

<%# Small screens: the same links in a drawer. The admin-sidebar controller is
    on <body> in layouts/admin, because the drawer and the menu button are
    siblings. %>
<div class="lg:hidden fixed inset-0 z-40 hidden" data-admin-sidebar-target="overlay">
  <div class="absolute inset-0 bg-scrim/40" data-action="click->admin-sidebar#close"></div>
  <aside class="relative w-72 max-w-[85vw] h-full flex flex-col border-r border-outline-variant bg-surface-container shadow-xl">
    <div class="flex items-center justify-between pr-3">
      <%= render "admin/shared/brand" %>
      <button type="button" aria-label="Close navigation" data-action="click->admin-sidebar#close" class="p-2 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high">
        <%= admin_icon(:x) %>
      </button>
    </div>
    <%= render "admin/shared/nav", categories: categories %>
    <%= render "admin/shared/sidebar_footer" %>
  </aside>
</div>
