<%= render "admin/shared/confirm_delete",
    url: admin_user_path(user),
    confirm_text: user.email,
    title: "Delete this user?",
    body: "This deletes #{user.email} with all enrollments, OAuth credentials, and calendar connections. You cannot undo it.",
    submit_text: "Delete user",
    button_text: local_assigns.fetch(:button_text, "Delete"),
    button_class: local_assigns.fetch(:button_class, "m3-btn-danger") %>
