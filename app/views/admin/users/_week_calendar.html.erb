<%# One week of classes for one term, from 8:00 to 21:00. %>
<% if enrollments.any? %>
  <%
    days = %w[Sun Mon Tue Wed Thu Fri Sat]
    time_slots = (8..20).to_a
    schedule = Hash.new { |h, k| h[k] = [] }
    enrollments.each do |enrollment|
      next unless enrollment.course
      enrollment.course.meeting_times.each do |mt|
        next if mt.day_of_week.blank? || mt.begin_time.nil? || mt.end_time.nil?
        start_hour = mt.begin_time / 100
        end_hour = (mt.end_time / 100.0).ceil
        active = mt.start_date && mt.end_date && Date.current.between?(mt.start_date.to_date, mt.end_date.to_date)
        schedule[Course::MeetingTime.day_of_weeks[mt.day_of_week]] << { meeting_time: mt, course: enrollment.course, start_hour: start_hour, duration: end_hour - start_hour, active: active }
      end
    end
  %>
  <div class="overflow-x-auto">
    <table class="min-w-[640px] w-full border-collapse text-xs">
      <thead>
        <tr>
          <th scope="col" class="w-12 border border-outline-variant bg-surface-container px-1 py-1 font-medium text-on-surface-variant">Time</th>
          <% days.each do |day| %>
            <th scope="col" class="border border-outline-variant bg-surface-container px-1 py-1 font-medium text-on-surface-variant"><%= day %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% time_slots.each do |hour| %>
          <tr>
            <th scope="row" class="border border-outline-variant bg-surface-container px-1 font-medium text-on-surface-variant whitespace-nowrap"><%= hour %>:00</th>
            <% days.each_index do |day_index| %>
              <td class="relative h-12 border border-outline-variant p-0">
                <% schedule[day_index].select { |item| item[:start_hour] == hour }.each do |item| %>
                  <div class="absolute inset-x-0 top-0 z-10 m-0.5 overflow-hidden rounded border p-0.5 <%= item[:active] ? "bg-primary-container border-primary text-on-primary-container" : "bg-surface-container-high border-outline-variant text-on-surface-variant" %>"
                       style="height: calc(<%= item[:duration] * 100 %>% - 4px);">
                    <div class="font-semibold truncate"><%= item[:course].subject %> <%= item[:course].course_number %></div>
                    <% if item[:meeting_time].building_room.present? %>
                      <div class="truncate"><%= item[:meeting_time].building_room %></div>
                    <% end %>
                  </div>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-sm text-on-surface-variant">No courses found for <%= term.name %>.</p>
<% end %>
