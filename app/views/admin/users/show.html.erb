<%= render "admin/shared/page_header", title: @user.full_name, subtitle: @user.email, back: [ "Users", admin_users_path ] do %>
  <% if policy(@user).edit? %>
    <%= link_to edit_admin_user_path(@user), class: "m3-btn-outlined" do %>
      <%= admin_icon(:pencil, css_class: "w-4 h-4") %> Edit
    <% end %>
  <% end %>
  <% if policy(@user).force_calendar_sync? && CourseCalendar.for_user(@user).exists? %>
    <%= button_to force_calendar_sync_admin_user_path(@user),
        method: :post,
        form: { data: { turbo_confirm: "Force sync calendar for #{@user.email}? This will update all events regardless of changes." } },
        class: "m3-btn-tonal" do %>
      <%= admin_icon(:refresh, css_class: "w-4 h-4") %> Force calendar sync
    <% end %>
  <% end %>
  <% if policy(@user).destroy? %>
    <%= render "delete_confirmation_modal", user: @user, button_text: "Delete user" %>
  <% end %>
<% end %>

<div class="space-y-6">
  <%= render "admin/shared/card", title: "Account" do %>
    <%= admin_details(columns: 3) do |d| %>
      <% d.item("First name") { @user.first_name } %>
      <% d.item("Last name") { @user.last_name } %>
      <% d.item("Email") { @user.email } %>
      <% d.item("User ID") do %>
        <span class="inline-flex flex-wrap items-center gap-2">
          <code class="px-2 py-0.5 rounded bg-surface-container-high font-mono text-xs"><%= @user.public_id %></code>
          <%= render "admin/shared/copy_button", value: @user.public_id %>
        </span>
      <% end %>
      <% if policy(@user).view_access_level? %>
        <% d.item("Access level") { render "access_badge", user: @user } %>
      <% end %>
      <% d.item("Last calendar sync") do %>
        <% if @user.last_calendar_sync_at %>
          <span title="<%= l(@user.last_calendar_sync_at, format: :long) %>"><%= time_ago_in_words(@user.last_calendar_sync_at) %> ago</span>
        <% else %>
          <span class="text-on-surface-variant">Never synced</span>
        <% end %>
        <% if @user.calendar_needs_sync %>
          <%= admin_badge("Needs sync", :warning) %>
        <% end %>
      <% end %>
      <% d.item("Signed up") { l(@user.created_at, format: :long) } %>
      <% d.item("ICS calendar URL", wide: true) do %>
        <% if @user.calendar_token.present? %>
          <span class="flex flex-wrap items-center gap-2">
            <code class="px-2 py-0.5 rounded bg-surface-container-high font-mono text-xs break-all"><%= @user.cal_url %></code>
            <%= render "admin/shared/copy_button", value: @user.cal_url %>
          </span>
        <% else %>
          <span class="text-on-surface-variant">No calendar token</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <% if policy(@user).view_sessions? %>
      <% session_actions = capture do %>
        <% if @sessions.any? %>
          <%= button_to "End all sessions", revoke_all_sessions_admin_user_path(@user),
              method: :delete,
              form: { data: { turbo_confirm: "End every session for this account? They will have to sign in again." } },
              class: "m3-btn-text text-error" %>
        <% end %>
      <% end %>
      <%= render "admin/shared/card", title: "Signed-in devices", subtitle: "#{@sessions.size} active", actions: session_actions do %>
        <% if @sessions.any? %>
          <ul class="divide-y divide-outline-variant -my-2">
            <% @sessions.each do |session| %>
              <li class="flex items-start justify-between gap-3 py-3">
                <div class="min-w-0 text-sm">
                  <p class="text-on-surface"><%= session.device_label %></p>
                  <p class="text-xs text-on-surface-variant">
                    <%= session.source == "passkey" ? "Passkey#{" · #{session.passkey.nickname}" if session.passkey}" : "Google sign-in" %>
                    <% if session.ip_address.present? %> · <%= session.ip_address %><% end %>
                  </p>
                  <p class="text-xs text-on-surface-variant">
                    Started <%= session.created_at.to_date %>
                    <% if session.last_seen_at %> · last seen <%= time_ago_in_words(session.last_seen_at) %> ago<% end %>
                  </p>
                </div>
                <%= button_to "End", revoke_session_admin_user_path(@user, session_id: session.id),
                    method: :delete,
                    form: { data: { turbo_confirm: "End this session?" } },
                    class: "m3-btn-outlined px-3 py-1" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= render "admin/shared/empty_state", message: "No active sessions." %>
        <% end %>
      <% end %>
    <% end %>

    <%= render "admin/shared/card", title: "Friends", subtitle: "#{@friends.size} accepted" do %>
      <% if policy(@user).manage_friendships? %>
        <%= form_with url: add_friend_admin_user_path(@user), method: :post, class: "mb-4 flex flex-col sm:flex-row gap-2 sm:items-end" do |f| %>
          <div class="flex-1">
            <%= f.label :friend_id, "Add a friend by email or user ID", class: "m3-label" %>
            <%= f.text_field :friend_id, placeholder: "email@wit.edu or usr_abc123", class: "m3-input" %>
          </div>
          <%= f.submit "Add friend", class: "m3-btn-tonal justify-center cursor-pointer" %>
        <% end %>
      <% end %>

      <% if @friends.any? %>
        <ul class="divide-y divide-outline-variant">
          <% @friends.each do |friend| %>
            <li class="flex flex-wrap items-center justify-between gap-2 py-2">
              <div class="min-w-0">
                <%= link_to friend.full_name, admin_user_path(friend), class: "text-sm font-medium text-primary hover:underline" %>
                <p class="text-xs text-on-surface-variant break-all"><%= friend.email %></p>
              </div>
              <% if policy(@user).manage_friendships? %>
                <%= button_to "Remove", remove_friend_admin_user_path(@user, friend_id: friend.public_id),
                    method: :delete,
                    form: { data: { turbo_confirm: "Remove #{friend.full_name} as a friend?" } },
                    class: "m3-btn-text text-error" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "admin/shared/empty_state", message: "No friends yet." %>
      <% end %>

      <% if @incoming_requests.any? || @outgoing_requests.any? %>
        <div class="mt-4 pt-4 border-t border-outline-variant space-y-2 text-xs">
          <p class="font-medium text-on-surface-variant uppercase tracking-wide">Pending requests</p>
          <% @incoming_requests.each do |request| %>
            <p><%= admin_badge("Incoming", :warning) %> <%= request.requester.full_name %> <code class="text-on-surface-variant"><%= request.requester.public_id %></code></p>
          <% end %>
          <% @outgoing_requests.each do |request| %>
            <p><%= admin_badge("Outgoing", :info) %> <%= request.addressee.full_name %> <code class="text-on-surface-variant"><%= request.addressee.public_id %></code></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if policy(@user).view_oauth_credentials? && @oauth_credentials.any? %>
    <%= render "admin/shared/card", title: "Connected accounts", subtitle: "OAuth credentials for calendar sync", flush: true do %>
      <ul class="divide-y divide-outline-variant">
        <% @oauth_credentials.each do |credential| %>
          <li class="px-4 sm:px-6 py-4 flex flex-col md:flex-row md:items-start gap-4">
            <div class="flex-1 min-w-0">
              <p class="flex flex-wrap items-center gap-2">
                <span class="font-medium text-on-surface break-all"><%= credential.email %></span>
                <%= admin_badge(credential.provider.capitalize, :info) %>
                <% if credential.token_expires_at && credential.token_expires_at < Time.current %>
                  <%= admin_badge("Expired", :danger) %>
                <% elsif credential.token_expires_at && credential.token_expires_at < 1.day.from_now %>
                  <%= admin_badge("Expiring soon", :warning) %>
                <% end %>
              </p>
              <div class="mt-3">
                <%= admin_details(columns: 3) do |d| %>
                  <% d.item("Connected") { credential.created_at.strftime("%b %-d, %Y") } %>
                  <% d.item("Token expires") { credential.token_expires_at&.strftime("%b %-d, %Y %-l:%M %p") || "No expiration" } %>
                  <% d.item("Calendar") { credential.course_calendar&.summary || "Not connected" } %>
                <% end %>
              </div>
            </div>
            <div class="admin-actions flex flex-wrap gap-2">
              <% if policy(credential).refresh? %>
                <%= button_to "Refresh token", refresh_oauth_credential_admin_user_path(@user, credential_id: credential.id), method: :post, class: "m3-btn-outlined" %>
              <% end %>
              <% if policy(credential).revoke? %>
                <%= button_to "Revoke", revoke_oauth_credential_admin_user_path(@user, credential_id: credential.id),
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure? This will disconnect #{credential.email} from the calendar system." } },
                    class: "m3-btn-danger" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <% if policy(@user).view_enrollments? && @enrollments_by_term.any? %>
    <%= render "enrollments", enrollments_by_term: @enrollments_by_term %>
  <% end %>
</div>
