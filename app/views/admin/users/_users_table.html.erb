<%= turbo_frame_tag "users_table" do %>
  <%= admin_table(users, empty: params[:search].present? ? "No users match “#{params[:search]}”." : "No users yet.") do |t| %>
    <% t.column("User") do |user| %>
      <%= link_to user.full_name, admin_user_path(user), data: { turbo_frame: "_top" }, class: "font-medium text-primary hover:underline" %>
      <div class="text-xs text-on-surface-variant break-all"><%= user.email %></div>
    <% end %>
    <% if policy(User).view_access_level? %>
      <% t.column("Access") { |user| render "admin/users/access_badge", user: user } %>
    <% end %>
    <% t.column("Last sync") do |user| %>
      <% if user.last_calendar_sync_at %>
        <span title="<%= l(user.last_calendar_sync_at, format: :long) %>"><%= time_ago_in_words(user.last_calendar_sync_at) %> ago</span>
      <% end %>
      <% if user.calendar_needs_sync %>
        <%= admin_badge("Needs sync", :warning) %>
      <% end %>
    <% end %>
    <% t.column("Signed up") { |user| user.created_at.strftime("%b %-d, %Y") } %>
    <% t.column("Actions", align: :right, primary: false) do |user| %>
      <div class="admin-actions inline-flex flex-wrap justify-end gap-1">
        <% if policy(user).edit? %>
          <%= link_to "Edit", edit_admin_user_path(user), data: { turbo_frame: "_top" }, class: "m3-btn-text" %>
        <% end %>
        <% if policy(user).destroy? %>
          <%= render "admin/users/delete_confirmation_modal", user: user, button_text: "Delete", button_class: "m3-btn-text text-error" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
