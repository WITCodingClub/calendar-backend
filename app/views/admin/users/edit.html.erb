<%= render "admin/shared/page_header", title: "Edit #{@user.full_name}", back: [ "Back to user", admin_user_path(@user) ] %>

<%= render "admin/shared/card", css_class: "max-w-2xl" do %>
  <%= form_with(model: @user, url: admin_user_path(@user), method: :patch, class: "space-y-4") do |form| %>
    <%= render "admin/shared/form_errors", record: @user %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= render "admin/shared/form_field", form: form, attribute: :first_name do %>
        <%= form.text_field :first_name, class: "m3-input" %>
      <% end %>
      <%= render "admin/shared/form_field", form: form, attribute: :last_name do %>
        <%= form.text_field :last_name, class: "m3-input" %>
      <% end %>
    </div>
    <%# The email comes from the school sign-in, so admins cannot change it. %>
    <%= render "admin/shared/form_field", form: form, attribute: :email, hint: "The email comes from the WIT sign-in. You cannot change it here." do %>
      <%= form.email_field :email, class: "m3-input opacity-70", disabled: true %>
    <% end %>
    <% if policy(@user).edit_access_level? %>
      <%= render "admin/shared/form_field", form: form, attribute: :access_level do %>
        <%= form.select :access_level, User.access_levels.keys.map { |k| [ k.titleize, k ] }, {}, class: "m3-select" %>
      <% end %>
    <% end %>
    <div class="flex flex-col-reverse sm:flex-row gap-2 pt-2">
      <%= link_to "Cancel", admin_user_path(@user), class: "m3-btn-outlined justify-center" %>
      <%= form.submit "Save changes", class: "m3-btn-filled justify-center cursor-pointer" %>
    </div>
  <% end %>
<% end %>
