<%
  badges = {
    match: [ "Matches", :success ],
    mismatch: [ "Mismatch", :warning ],
    syncing: [ "Syncing…", :info ],
    never_synced: [ "Never synced", :neutral ],
    stale: [ "Sync out of date", :neutral ],
    not_in_25live: [ "Not in 25Live", :neutral ]
  }
  statuses = @buildings.to_h { |b| [ b, b.twenty_five_live_status(sync_in_progress: @sync_in_progress) ] }
  total = statuses.size
  synced = statuses.values.count { |s| s == :match || s == :mismatch }
  mismatched = statuses.values.count(:mismatch)
  missing = statuses.values.count(:not_in_25live)
  awaiting = total - synced - missing
%>

<%= render "admin/shared/page_header",
    title: "Buildings",
    subtitle: (@last_checked_at ? "Last 25Live sync: #{time_ago_in_words(@last_checked_at)} ago" : "No 25Live sync has run yet.") do %>
  <%= button_to (@sync_in_progress ? "Sync Running…" : "Sync 25Live Spaces"), sync_admin_buildings_path,
      method: :post,
      disabled: @sync_in_progress,
      form: { data: { turbo_confirm: "Queue a 25Live space sync? This will run in the background." } },
      class: "m3-btn-outlined disabled:opacity-50" %>
  <% if policy(Building).apply_all? %>
    <%= button_to "Apply All 25Live Names (#{mismatched})", apply_all_admin_buildings_path,
        method: :post,
        disabled: mismatched.zero?,
        form: { data: { turbo_confirm: "Apply 25Live formal names to all #{mismatched} mismatched building(s)?" } },
        class: "m3-btn-filled disabled:opacity-50" %>
  <% end %>
<% end %>

<% if @sync_in_progress %>
  <p role="status" class="mb-6 px-4 py-3 rounded-xl text-sm <%= Admin::ApplicationHelper::BADGE_TONES[:info] %>">A 25Live sync is running. It takes a few minutes. Reload the page when it finishes.</p>
<% elsif statuses.values.any? { |s| s == :never_synced || s == :stale } %>
  <p class="mb-6 px-4 py-3 rounded-xl text-sm <%= Admin::ApplicationHelper::BADGE_TONES[:warning] %>">Some buildings have no recent 25Live sync. Run a sync to see if 25Live has them.</p>
<% end %>

<%= render "admin/shared/stats" do %>
  <%= render "admin/shared/stat", label: "Total buildings", value: total %>
  <%= render "admin/shared/stat", label: "Have 25Live name", value: synced, tone: :success %>
  <%= render "admin/shared/stat", label: "Name mismatch", value: mismatched, tone: (mismatched.positive? ? :warning : nil) %>
  <% if awaiting.positive? %>
    <%= render "admin/shared/stat", label: "Awaiting sync", value: awaiting %>
  <% else %>
    <%= render "admin/shared/stat", label: "Not in 25Live", value: missing %>
  <% end %>
<% end %>

<%= admin_table(@buildings, empty: "No buildings yet. A course import adds them.") do |t| %>
  <% t.row_class { |building| "bg-secondary-container/20" if statuses[building] == :mismatch } %>
  <% t.column("Code") { |building| tag.code(building.abbreviation, class: "px-2 py-0.5 rounded bg-surface-container-high text-xs") } %>
  <% t.column("Current name (LeopardWeb)") { |building| building.name } %>
  <% t.column("Formal name (25Live)") do |building| %>
    <% if building.formal_name.present? %>
      <%= building.formal_name %>
    <% else %>
      <span class="text-on-surface-variant italic"><%= statuses[building] == :not_in_25live ? "None" : "Not synced" %></span>
    <% end %>
  <% end %>
  <% t.column("Rooms", align: :right) { |building| building.rooms.size.to_s } %>
  <% t.column("Status") { |building| admin_badge(*badges.fetch(statuses[building])) } %>
  <% t.column("Actions", align: :right, primary: false) do |building| %>
    <% if statuses[building] == :mismatch %>
      <%= button_to "Apply 25Live Name", apply_formal_name_admin_building_path(building),
          method: :post,
          form: { data: { turbo_confirm: "Update \"#{building.abbreviation}\" name from \"#{building.name}\" to \"#{building.formal_name}\"?" } },
          class: "m3-btn-outlined px-3 py-1" %>
    <% end %>
  <% end %>
<% end %>

<p class="mt-4 flex items-start gap-2 text-sm text-on-surface-variant">
  <%= admin_icon(:information, css_class: "w-5 h-5 shrink-0") %>
  <span>A sync reads every space from the 25Live API and fills the formal name from the 25Live building. Applying a 25Live name changes the building name in calendar event locations. The TBD and online placeholder buildings are not shown, because 25Live has no building for them.</span>
</p>
