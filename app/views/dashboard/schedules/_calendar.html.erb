<%# With view_mode "auto" (no view in the URL), small screens get the list and
    larger screens get the week grid. Each toggle marks the view it shows. %>
<% toggles = if schedule.view_mode == "auto"
               [ [ "list", "flex sm:hidden" ], [ "week", "hidden sm:flex" ] ]
             else
               [ [ schedule.view_mode, "flex" ] ]
             end %>

<div class="mx-auto space-y-4">

  <%# ── Header ─────────────────────────────────────────────────────────────── %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-on-surface"><%= title %></h1>

    <div class="flex flex-wrap items-center gap-3">
      <%# Term selector %>
      <% if schedule.terms.any? %>
        <form method="get" action="<%= path_for.call %>" class="flex items-center" data-controller="auto-submit">
          <% unless schedule.view_mode == "auto" %>
            <input type="hidden" name="view" value="<%= schedule.view_mode %>">
          <% end %>
          <% if schedule.view_mode == "week" %>
            <input type="hidden" name="week_start" value="<%= schedule.week_start.iso8601 %>">
          <% elsif schedule.view_mode == "month" %>
            <input type="hidden" name="month" value="<%= schedule.month_date.strftime("%Y-%m") %>">
          <% end %>
          <select name="term_uid" aria-label="Term" data-action="change->auto-submit#submit" class="m3-select w-auto">
            <%= options_for_select(schedule.terms.map { |term| [ term.name, term.uid ] }, schedule.selected_term&.uid) %>
          </select>
        </form>
      <% end %>

      <%# View toggle %>
      <% if schedule.selected_term %>
        <% toggles.each do |current, visibility| %>
          <div role="group" aria-label="View" class="<%= visibility %> rounded-xl overflow-hidden border border-outline-variant text-sm">
            <% [["list", "List"], ["week", "Week"], ["month", "Month"]].each do |mode, label| %>
              <%= link_to path_for.call(view: mode, term_uid: schedule.selected_term.uid),
                "aria-current": ("page" if current == mode),
                  class: "px-3 py-1.5 font-medium transition-colors #{current == mode ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-container-high'}" do %>
                <%= label %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <% locals = { schedule: schedule, path_for: path_for, empty_hint: empty_hint } %>

  <% if schedule.selected_term.nil? %>
    <div class="m3-card p-8 text-center text-on-surface-variant">No term data available.</div>
  <% elsif schedule.view_mode == "auto" %>
    <div class="sm:hidden"><%= render "dashboard/schedules/list", **locals %></div>
    <div class="hidden sm:block space-y-4"><%= render "dashboard/schedules/week", **locals %></div>
  <% else %>
    <%= render "dashboard/schedules/#{schedule.view_mode}", **locals %>
  <% end %>
</div>
