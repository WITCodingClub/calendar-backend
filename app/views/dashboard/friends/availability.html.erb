<% content_for :title, "#{@friend.full_name}'s Availability" %>
<% blocks_by_date = @busy_blocks.group_by(&:date) %>
<% this_week_start = Time.zone.today.beginning_of_week(:monday) %>

<div class="m3-page-wide space-y-4">
  <%= render "shared/page_header",
      title: "#{@friend.full_name}'s Availability",
      back: [ "Friends", dashboard_friends_path ],
      description: "#{@friend.first_name} shares only the times they are busy, not their courses." do %>
    <%= link_to "Previous week", dashboard_friend_path(@friend.public_id, week_start: (@week_start - 7).iso8601), class: "m3-btn-text" %>
    <% unless @week_start == this_week_start %>
      <%= link_to "This week", dashboard_friend_path(@friend.public_id), class: "m3-btn-text" %>
    <% end %>
    <%= link_to "Next week", dashboard_friend_path(@friend.public_id, week_start: (@week_start + 7).iso8601), class: "m3-btn-text" %>
  <% end %>

  <% if @can_set_visibility %>
    <%= render "visibility_form", friend: @friend, friendship: @friendship %>
  <% end %>

  <div class="m3-card divide-y divide-outline-variant overflow-hidden">
    <% (@week_start..(@week_start + 6)).each do |date| %>
      <div class="px-5 py-3 flex flex-wrap items-start justify-between gap-3">
        <p class="text-sm font-medium text-on-surface"><%= date.strftime("%A, %b %-d") %></p>
        <% blocks = blocks_by_date.fetch(date, []) %>
        <% if blocks.empty? %>
          <p class="text-sm text-on-surface-variant">Free</p>
        <% else %>
          <ul class="text-sm text-on-surface text-right space-y-1">
            <% blocks.each do |block| %>
              <li>Busy <%= block.start %> to <%= block.end %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
