<%# What the signed-in user shares with this friend. Only their own level. %>
<%= form_with url: visibility_dashboard_friend_path(friend.public_id),
    method: :patch,
    class: "m3-card px-5 py-4 flex flex-wrap items-center justify-between gap-3" do %>
  <label for="visibility" class="text-sm text-on-surface">
    What <%= friend.first_name %> can see of your schedule
  </label>
  <div class="flex items-center gap-2">
    <%= select_tag :visibility,
        options_for_select([
          [ "Full schedule", "full" ],
          [ "Only when I am busy", "availability_only" ]
        ], friendship.visibility_set_by(current_user)),
        class: "m3-select w-auto" %>
    <%= submit_tag "Save", class: "m3-btn-tonal" %>
  </div>
<% end %>
