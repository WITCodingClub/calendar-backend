<% content_for :title, "#{@friend.full_name}'s Schedule" %>

<div class="m3-page-wide space-y-4">
  <%= render "shared/back_link", label: "Friends", path: dashboard_friends_path %>

  <% if @can_set_visibility %>
    <%= render "visibility_form", friend: @friend, friendship: @friendship %>
  <% end %>

  <%= render "dashboard/schedules/calendar",
      schedule: @schedule,
      title: "#{@friend.full_name}'s Schedule",
      path_for: ->(**query) { dashboard_friend_path(@friend.public_id, query) },
      no_terms_message: "#{@friend.full_name} has no courses yet.",
      empty_hint: "#{@friend.full_name} has not imported a schedule for this term." %>
</div>
