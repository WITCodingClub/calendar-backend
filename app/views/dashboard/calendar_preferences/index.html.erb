<% content_for :title, "Preferences" %>

<div class="max-w-2xl mx-auto space-y-6">
  <h1 class="text-2xl font-bold text-on-surface">Calendar Preferences</h1>

  <!-- Global preferences -->
  <div class="m3-card overflow-hidden">
    <div class="px-5 py-4 border-b border-outline-variant">
      <h2 class="text-base font-semibold text-on-surface">Global Defaults</h2>
      <p class="text-xs text-on-surface-variant mt-0.5">Applied to your classes unless overridden per event type. University calendar events keep their own defaults.</p>
    </div>
    <div class="px-5 py-4">
      <%= form_with url: dashboard_calendar_preference_path("global"), method: :patch, class: "space-y-4" do |f| %>
        <div>
          <label class="m3-label">Event title template</label>
          <%= f.text_field :title_template,
              name: "calendar_preference[title_template]",
              value: @global_pref.title_template,
              placeholder: "{{subject}} {{course_number}} — {{title}}",
              class: "m3-input" %>
        </div>
        <div>
          <label class="m3-label">Description template</label>
          <%= f.text_area :description_template,
              name: "calendar_preference[description_template]",
              value: @global_pref.description_template,
              rows: 3,
              class: "m3-input" %>
        </div>
        <div>
          <label class="m3-label">Location template</label>
          <%= f.text_field :location_template,
              name: "calendar_preference[location_template]",
              value: @global_pref.location_template,
              placeholder: "{{building_room}}",
              class: "m3-input" %>
        </div>
        <div class="flex justify-end">
          <%= f.submit "Save", class: "m3-btn-filled" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- University calendar events -->
  <div class="m3-card overflow-hidden">
    <div class="px-5 py-4 border-b border-outline-variant">
      <h2 class="text-base font-semibold text-on-surface">University Calendar Events</h2>
      <p class="text-xs text-on-surface-variant mt-0.5">Holidays, deadlines, and other campus events.</p>
    </div>
    <%= form_with url: university_events_dashboard_calendar_preferences_path, method: :patch, class: "px-5 py-4 space-y-4 border-b border-outline-variant" do %>
      <label class="flex items-start gap-3 cursor-pointer">
        <%= hidden_field_tag :sync_university_events, "0", id: nil %>
        <%= check_box_tag :sync_university_events, "1", @extension_config.sync_university_events, class: "mt-1 accent-primary" %>
        <span>
          <span class="block text-sm font-medium text-on-surface">Sync university events to Google Calendar</span>
          <span class="block text-xs text-on-surface-variant">
            Holidays always sync. Pick the other categories you want below.
          </span>
        </span>
      </label>

      <fieldset class="space-y-2 pl-7">
        <legend class="m3-label">Categories</legend>
        <%= hidden_field_tag "university_event_categories[]", "", id: nil %>
        <% selected_categories = @extension_config.university_event_categories || [] %>
        <% (UniversityCalendarEvent::CATEGORIES - [ "holiday" ]).each do |category| %>
          <label class="flex items-start gap-3 cursor-pointer">
            <%= check_box_tag "university_event_categories[]", category, selected_categories.include?(category),
                id: "university_event_category_#{category}", class: "mt-1 accent-primary" %>
            <span>
              <span class="block text-sm text-on-surface"><%= category.titleize %></span>
              <span class="block text-xs text-on-surface-variant"><%= UniversityCalendarEvent.category_description(category) %></span>
            </span>
          </label>
        <% end %>
      </fieldset>

      <div class="flex justify-end">
        <%= submit_tag "Save", class: "m3-btn-filled", data: { disable_with: false } %>
      </div>
    <% end %>
    <div class="px-5 py-4 flex items-center justify-between gap-4">
      <p class="text-sm text-on-surface">
        Reminders:
        <% if @uni_cal_pref.reminder_settings.nil? %>
          the default for university events
        <% elsif @uni_cal_pref.reminder_settings.empty? %>
          off
        <% else %>
          your own choice
        <% end %>
      </p>
      <%= link_to "Change", dashboard_notifications_path, class: "text-xs text-primary hover:underline" %>
    </div>
  </div>

  <!-- Per-event-type preferences summary -->
  <% if @event_type_prefs.any? %>
    <div class="m3-card overflow-hidden">
      <div class="px-5 py-4 border-b border-outline-variant">
        <h2 class="text-base font-semibold text-on-surface">Event Type Overrides</h2>
      </div>
      <div class="divide-y divide-outline-variant">
        <% @event_type_prefs.each do |pref| %>
          <div class="px-5 py-3 flex items-center justify-between">
            <span class="text-sm text-on-surface"><%= pref.event_type&.humanize %></span>
            <div class="flex gap-2">
              <%= link_to "Edit",
                  dashboard_calendar_preference_path(pref.event_type),
                  class: "text-xs text-primary hover:underline" %>
              <%= button_to "Reset",
                  dashboard_calendar_preference_path(pref.event_type),
                  method: :patch,
                  params: { calendar_preference: { title_template: nil, description_template: nil, location_template: nil } },
                  class: "text-xs text-on-surface-variant hover:text-error" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
