<%# One planned program on the My programs page (#867): the courses it adds.
    Locals: program (a StudentProgramSerializer hash), progress (the
    DegreeProgress result, or nil), entry (the program's DegreeProgress
    entry, or nil) %>
<% dom_id = "program-#{program[:id]}" %>
<div class="px-5 py-4 space-y-3 text-sm text-on-surface" id="<%= dom_id %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <h3 class="text-base font-semibold text-on-surface"><%= program[:name] %></h3>
      <p class="text-xs text-on-surface-variant">
        <%= program_role_label(program[:role]) %> · <%= program[:catalog_year] %> catalog
      </p>
    </div>
    <%= button_to dashboard_planned_program_path(program[:id]), method: :delete,
        class: "m3-btn-text text-sm", aria: { label: "Remove #{program[:name]}" },
        data: { turbo_confirm: "Remove #{program[:name]} from your planned programs?" } do %>
      <%= icon(:trash, css_class: "w-4 h-4") %> Remove
    <% end %>
  </div>

  <% if program[:plans].any? %>
    <%= render "dashboard/programs/plan_form", program: program %>
  <% end %>

  <% if entry %>
    <% added = courses_added(progress, entry) %>
    <% if added.empty? %>
      <p class="text-on-surface-variant">You have met every requirement of this program that WIT Calendar can check.</p>
    <% else %>
      <div>
        <p class="text-xs font-semibold text-on-surface-variant">
          Courses it adds (<%= added.count { |item| !item[:shared] } %> new, <%= added.count { |item| item[:shared] } %> also in your programs)
        </p>
        <ul class="mt-1 divide-y divide-outline-variant rounded-lg border border-outline-variant" data-courses-added>
          <% added.each do |item| %>
            <li class="px-3 py-2 flex items-center justify-between gap-3">
              <span>
                <%= requirement_text(item[:row]) %>
                <% if item[:shared] %>
                  <span class="text-xs text-on-surface-variant">(also in your programs)</span>
                <% end %>
              </span>
              <%= progress_badge(item[:row][:status]) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <p class="text-on-surface-variant">The degree catalog for this catalog year is not imported yet.</p>
  <% end %>
</div>
