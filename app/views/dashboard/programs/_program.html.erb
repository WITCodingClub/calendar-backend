<%# One active program from LeopardWeb on the My programs page (#867), with its
    plan of study against real terms.
    Locals: program (a StudentProgramSerializer hash), progress (its
    DegreeProgress entry, or nil) %>
<% dom_id = "program-#{program[:id]}" %>
<article class="m3-card overflow-hidden" id="<%= dom_id %>" aria-labelledby="<%= dom_id %>-title">
  <div class="px-5 py-4 border-b border-outline-variant flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <h3 id="<%= dom_id %>-title" class="text-base font-semibold text-on-surface"><%= program[:name] %></h3>
      <div class="flex flex-wrap gap-2">
        <span class="m3-badge m3-badge-primary"><%= program_role_label(program[:role]) %></span>
        <span class="m3-badge m3-badge-secondary">
          <%= program[:source] == "student" ? "Corrected by you" : "From LeopardWeb" %>
        </span>
      </div>
    </div>
    <%= link_to edit_dashboard_program_path(program[:id]), class: "m3-btn-text text-sm",
        aria: { label: "Correct #{program[:name]}" } do %>
      <%= icon(:pencil, css_class: "w-4 h-4") %> Correct
    <% end %>
  </div>

  <div class="px-5 py-4 space-y-4 text-sm text-on-surface">
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-3">
      <div>
        <dt class="text-xs text-on-surface-variant">Catalog year</dt>
        <dd><%= program[:catalog_year] || "Unknown" %></dd>
      </div>
      <div>
        <dt class="text-xs text-on-surface-variant">Start term</dt>
        <dd>
          <%= program[:start_term] || "Unknown" %>
          <% if program[:start_term_source] == "admit_term" %>
            <span class="text-xs text-on-surface-variant">(your admit term)</span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-on-surface-variant">Plan of study</dt>
        <dd>
          <%= program[:plan] || "None" %>
          <% if program[:plan_source] == "assumed" %>
            <span class="m3-badge m3-badge-tertiary">Assumed</span>
          <% elsif program[:plan_source] == "student" %>
            <span class="m3-badge m3-badge-primary">Confirmed by you</span>
          <% end %>
        </dd>
      </div>
      <% if program[:degree] %>
        <div>
          <dt class="text-xs text-on-surface-variant">Degree</dt>
          <dd><%= program[:degree] %></dd>
        </div>
      <% end %>
      <% if program[:concentration] %>
        <div>
          <dt class="text-xs text-on-surface-variant">Concentration</dt>
          <dd><%= program[:concentration] %></dd>
        </div>
      <% end %>
      <% if program[:study_path] %>
        <div>
          <dt class="text-xs text-on-surface-variant">Study path</dt>
          <dd><%= program[:study_path] %></dd>
        </div>
      <% end %>
    </dl>

    <% if program[:plans].any? %>
      <%= render "dashboard/programs/plan_form", program: program %>
    <% end %>

    <% if program[:matched] != true %>
      <p class="text-xs text-on-surface-variant">
        WIT Calendar cannot link this program to the degree catalog yet, so it cannot show the plan of study.
      </p>
    <% elsif progress.nil? %>
      <p class="text-xs text-on-surface-variant">The degree catalog for this catalog year is not imported yet.</p>
    <% else %>
      <% semesters = plan_semesters(program, progress) %>
      <p class="text-xs text-on-surface-variant">
        <%= progress[:counts]["done"] %> done, <%= progress[:counts]["in_progress"] %> in progress,
        <%= progress[:counts]["open"] %> to do.
      </p>
      <% if semesters.any? %>
        <details class="group" data-plan-terms>
          <summary class="cursor-pointer text-sm font-medium text-primary">Show the plan by term</summary>
          <p class="mt-2 text-xs text-on-surface-variant">
            <% if program[:start_term].nil? %>
              WIT Calendar does not know your start term, so the plan shows plan years only.
            <% else %>
              The plan years count from your start term, <%= program[:start_term] %>.
            <% end %>
          </p>
          <div class="mt-3 space-y-3">
            <% semesters.each do |(year, season, term), rows| %>
              <div>
                <h4 class="text-xs font-semibold text-on-surface-variant">
                  <%= plan_semester_title(year, season) %><% if term %>: <span class="text-on-surface"><%= term %></span><% end %>
                </h4>
                <ul class="mt-1 divide-y divide-outline-variant rounded-lg border border-outline-variant">
                  <% rows.each do |row| %>
                    <li class="px-3 py-2 flex items-center justify-between gap-3">
                      <span><%= requirement_text(row) %><% if row[:course] && row[:kind] != "course" %> <span class="text-xs text-on-surface-variant">(<%= row[:course] %>)</span><% end %></span>
                      <%= progress_badge(row[:status]) %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>
</article>
