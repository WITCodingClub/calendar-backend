<%# The prerequisite graph of a course (#448). Prerequisites are on the left,
    the courses it unlocks on the right. Each course box links to its own
    page, which shows its own graph.
    Locals: graph (Catalog::PrerequisiteGraph) %>
<% layout = prerequisite_graph_layout(graph) %>
<%= render "shared/section_card", title: "Prerequisite map", id: "prerequisite-map",
    description: "Courses on the left come first. Select a course to see its own map." do %>
  <div class="overflow-x-auto px-5 py-4" data-controller="scroll-center">
    <div class="relative mx-auto" role="group" aria-label="Prerequisite map for <%= graph.course.code %>"
         style="width: <%= layout.width %>px; height: <%= layout.height %>px">
      <svg class="absolute inset-0 overflow-visible" width="<%= layout.width %>" height="<%= layout.height %>" aria-hidden="true" focusable="false">
        <% layout.lines.each do |line| %>
          <%= tag.path d: line.path, fill: "none", class: "stroke-outline", "stroke-width": 1.5,
                       "stroke-dasharray": ("5 4" unless line.required) %>
        <% end %>
      </svg>

      <% layout.boxes.each do |box| %>
        <% node = box.node %>
        <% position = "left: #{box.x}px; top: #{box.y}px; width: #{Dashboard::PrerequisiteGraphHelper::GRAPH_NODE_WIDTH}px; height: #{Dashboard::PrerequisiteGraphHelper::GRAPH_NODE_HEIGHT}px" %>
        <% label = capture do %>
          <span class="block text-sm font-medium whitespace-nowrap"><%= node.code %></span>
          <span class="block text-xs truncate <%= node.root? ? 'text-on-primary-container' : 'text-on-surface-variant' %>"><%= node.linked ? node.title : "Not in WIT Calendar" %></span>
        <% end %>
        <% if node.root? %>
          <div class="absolute rounded-lg px-3 py-1.5 bg-primary-container text-on-primary-container ring-2 ring-primary"
               style="<%= position %>" aria-current="page" title="<%= node.title %>" data-scroll-center-target="center"><%= label %></div>
        <% elsif node.linked %>
          <%= link_to dashboard_catalog_course_path(node.code, anchor: "prerequisite-map"),
              class: "absolute rounded-lg px-3 py-1.5 bg-surface-container-low text-on-surface border border-outline-variant hover:border-primary hover:bg-surface-container focus-visible:outline-2 focus-visible:outline-primary",
              style: position, title: node.title do %>
            <%= label %>
          <% end %>
        <% else %>
          <div class="absolute rounded-lg px-3 py-1.5 bg-surface text-on-surface-variant border border-dashed border-outline-variant"
               style="<%= position %>"><%= label %></div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="px-5 pb-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-on-surface-variant">
    <span class="inline-flex items-center gap-1.5">
      <svg width="24" height="6" aria-hidden="true"><line x1="0" y1="3" x2="24" y2="3" class="stroke-outline" stroke-width="1.5"></line></svg>
      Required
    </span>
    <span class="inline-flex items-center gap-1.5">
      <svg width="24" height="6" aria-hidden="true"><line x1="0" y1="3" x2="24" y2="3" class="stroke-outline" stroke-width="1.5" stroke-dasharray="5 4"></line></svg>
      One of several options
    </span>
    <% if graph.truncated? %>
      <span>The map stops after <%= Catalog::PrerequisiteGraph::MAX_DEPTH %> levels or <%= Catalog::PrerequisiteGraph::MAX_PREREQUISITES %> courses. Select a course on the left to see more.</span>
    <% end %>
    <% if graph.hidden_unlocks.positive? %>
      <span><%= pluralize(graph.hidden_unlocks, "more course") %> also <%= graph.hidden_unlocks == 1 ? "needs" : "need" %> this one. "Prerequisite for" above lists them all.</span>
    <% end %>
  </div>
<% end %>
