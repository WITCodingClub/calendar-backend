<%= render layout: "devise/shared/card", locals: { heading: "WIT Calendar", intro: "Sign in with your WIT account", links: false } do %>
  <div class="space-y-3"
       data-controller="passkey-sign-in"
       data-passkey-sign-in-options-url-value="<%= passkey_session_options_path %>"
       data-passkey-sign-in-session-url-value="<%= passkey_session_path %>">
    <%= link_to "/auth/google_oauth2?scope=email%20profile", class: "m3-btn-provider" do %>
      <%= icon(:google) %>
      Sign in with Google
    <% end %>

    <%# A POST, not a link: omniauth-rails_csrf_protection checks the token.
        Turbo stays off so the browser follows the redirect to Microsoft. %>
    <% if MicrosoftSignIn.enabled? %>
      <%= button_to MicrosoftSignIn::REQUEST_PATH,
          method: :post,
          form: { data: { turbo: false } },
          class: "m3-btn-provider" do %>
        <%= icon(:microsoft) %>
        Sign in with Microsoft
      <% end %>
    <% end %>

    <%# passkey_sign_in_controller.js shows the button only when the browser
        can run the ceremony. %>
    <button type="button"
            hidden
            class="m3-btn-provider"
            data-passkey-sign-in-target="button"
            data-action="passkey-sign-in#signIn">
      <%= icon(:passkey, css_class: "w-5 h-5 text-primary") %>
      Sign in with a passkey
    </button>

    <p hidden class="m3-alert-error text-sm" data-passkey-sign-in-target="error"></p>
  </div>

  <p class="text-center text-xs text-on-surface-variant mt-6">
    Wentworth Institute of Technology accounts only
  </p>
<% end %>
