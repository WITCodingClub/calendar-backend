<h1 style="margin: 0 0 16px 0; font-size: 22px; line-height: 1.3; color: #1f1b13;">New friend request</h1>

<p style="margin: 0 0 16px 0;">
  Hi<%= " #{@addressee.first_name}" if @addressee.first_name.present? %>,
</p>

<p style="margin: 0 0 16px 0;">
  <strong><%= @requester.full_name %></strong> sent you a friend request on WIT Calendar.
  Friends can see each other's class schedules.
</p>

<% if @friendship.temporary? %>
  <p style="margin: 0 0 16px 0;">This friendship ends on <%= @friendship.expires_at.to_date.to_fs(:long) %>.</p>
<% end %>

<%= render "shared/mailer_button", url: @requests_url, label: "Review the request" %>

<p style="margin: 0; font-size: 14px; color: #4d4639;">
  If you do not know this person, you can decline the request.
</p>
